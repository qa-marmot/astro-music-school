FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG PUBLIC_SITE_URL

ENV PUBLIC_SITE_URL=$PUBLIC_SITE_URL

RUN npm run build

# ---- serve stage (optional, for local preview) ----
FROM nginx:alpine AS serve
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
