{
  "name": "music-school-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts --project=chromium",
    "test:visual": "playwright test tests/e2e/visual.spec.ts --project=chromium",
    "test:visual:update": "playwright test tests/e2e/visual.spec.ts --project=chromium --update-snapshots",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.1.6",
    "@astrojs/tailwind": "^5.1.0",
    "astro": "^4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.42.1",
    "@types/node": "^20.11.25",
    "@vitest/coverage-v8": "^1.4.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.2",
    "vitest": "^1.4.0"
  }
}
