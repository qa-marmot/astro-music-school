---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ActionLink from '../components/ui/ActionLink.astro';
import CTASection from '../components/ui/CTASection.astro';
import EditorialImage from '../components/media/EditorialImage.astro';
import { siteContent } from '../data/site';

const trialChecks: Record<string, string> = {
  piano: '椅子の高さや手の使い方を確認し、弾いてみたい曲までの進め方をご相談します。',
  guitar: '楽器の大きさと構え方を確かめ、コードや旋律を一緒に鳴らします。',
  violin: '身体に合う楽器のサイズを伺い、無理のない姿勢と弓の持ち方を確認します。',
  vocal: '話し声や呼吸の状態を確かめ、楽に出せる音域から声を出します。',
};
---

<BaseLayout title="レッスン内容" description="ピアノ、ギター、バイオリン、声楽の個人レッスンをご案内します。">
  <PageHeader variant="editorial" title="レッスン内容" eyebrow="一対一で学ぶ4つの楽器" description="初めての一音から、表現を深めたい方まで。いまの経験と生活のペースに合う進め方を一緒に考えます。" />

  <nav class="sticky top-16 z-40 border-y border-line bg-canvas/95 lg:top-[72px]" aria-label="コース内ナビゲーション">
    <div class="site-container flex gap-2 overflow-x-auto py-3">
      {siteContent.courses.map((course) => <a href={`#${course.id}`} class="action action--tertiary action--sm whitespace-nowrap">{course.name}</a>)}
    </div>
  </nav>

  <section class="site-section site-section--subtle">
    <div class="site-container">
      <SectionHeading title="興味のある楽器からご覧ください" description="すべて講師との一対一レッスンです。対象年齢は目安のため、楽器のサイズやご経験に応じてご相談ください。" />
      <div class="grid border-t border-line md:grid-cols-2 lg:grid-cols-4">
        {siteContent.courses.map((course) => (
          <a href={`#${course.id}`} class="group border-b border-line py-6 no-underline md:px-6 lg:border-r">
            <span class="mb-2 block font-serif text-xl font-bold text-ink group-hover:text-brand">{course.name}</span>
            <span class="block text-sm text-ink-secondary">{course.ages}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div>
    {siteContent.courses.map((course, index) => (
      <section id={course.id} class={`site-section scroll-mt-32 border-b border-line ${index % 2 === 1 ? 'bg-subtle' : 'bg-canvas'}`}>
        <div class="site-container grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
          <div class={`lg:col-span-5 ${index % 2 === 1 ? 'lg:order-2 lg:col-start-8' : ''}`}>
            <EditorialImage image={course.photo} aspect="4 / 3" sizes="(min-width: 1024px) 40vw, 100vw" />
          </div>
          <div class={`lg:col-span-6 ${index % 2 === 1 ? 'lg:order-1 lg:col-start-1' : 'lg:col-start-7'}`}>
            <p class="mb-2 text-sm font-bold text-accent-strong">対象の目安：{course.ages}</p>
            <h2 class="section-title mb-4">{course.name}</h2>
            <p class="lead mb-7 text-ink-secondary">{course.description}</p>

            <div class="grid gap-6 border-y border-line py-6 sm:grid-cols-2">
              <div>
                <h3 class="mb-3 text-base font-bold text-ink">こんな方へ</h3>
                <ul class="m-0 space-y-2 p-0 text-sm leading-7 text-ink-secondary">
                  {course.levels.map((level) => <li class="flex gap-2"><span class="text-accent-strong" aria-hidden="true">—</span><span>{level}</span></li>)}
                </ul>
              </div>
              <div>
                <h3 class="mb-3 text-base font-bold text-ink">体験で確認すること</h3>
                <p class="mb-0 text-sm leading-7 text-ink-secondary">{trialChecks[course.id]}</p>
              </div>
            </div>

            <ul class="my-7 grid gap-2 text-sm text-ink-secondary">
              {course.features.map((feature) => <li class="flex gap-3"><span class="mt-3 h-1.5 w-1.5 flex-none bg-accent" aria-hidden="true"></span><span>{feature}</span></li>)}
            </ul>
            <ActionLink href={`/trial?instrument=${course.id}`}>{course.name}の体験を申し込む</ActionLink>
          </div>
        </div>
      </section>
    ))}
  </div>

  <CTASection
    tone="quiet"
    align="left"
    title="どの楽器にするか迷っている方へ"
    description="経験や弾いてみたい曲をお問い合わせフォームにご記入ください。楽器ごとの一般的な違いをご案内します。"
    primaryHref="/contact"
    primaryLabel="楽器選びを相談する"
    secondaryHref="/pricing"
    secondaryLabel="料金を見る"
  />
</BaseLayout>
