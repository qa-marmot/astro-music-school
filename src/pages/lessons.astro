---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ActionLink from '../components/ui/ActionLink.astro';
import CTASection from '../components/ui/CTASection.astro';
import { siteContent } from '../data/site';
---

<BaseLayout title="レッスン内容" description="ピアノ、ギター、バイオリン、声楽の個人レッスンをご案内します。">
  <PageHeader title="レッスン内容" eyebrow="4つの個人レッスン" description="初めての一音から、表現を深めたい方まで。目標と生活のペースに合わせて学べます。" />

  <nav class="border-b border-line bg-canvas" aria-label="コース内ナビゲーション">
    <div class="site-container flex gap-2 overflow-x-auto py-4">
      {siteContent.courses.map((course) => <a href={`#${course.id}`} class="action action--tertiary action--sm whitespace-nowrap">{course.name}</a>)}
    </div>
  </nav>

  <section class="site-section">
    <div class="site-container">
      <SectionHeading title="コースを比べる" description="すべて講師との1対1レッスンです。年齢は目安のため、楽器のサイズやご希望に応じてご相談ください。" />
      <div class="grid gap-px border-y border-line bg-line md:grid-cols-2 lg:grid-cols-4">
        {siteContent.courses.map((course) => (
          <article class="bg-canvas px-5 py-7">
            <div class="mb-5 h-1 w-10 bg-accent" aria-hidden="true"></div>
            <h3 class="mb-2 text-xl font-bold">{course.name}</h3>
            <p class="mb-4 text-sm leading-7 text-ink-secondary">{course.summary}</p>
            <p class="mb-1 text-xs font-bold text-ink-muted">対象の目安</p>
            <p class="mb-5 text-sm font-bold text-brand">{course.ages}</p>
            <a href={`#${course.id}`} class="text-link text-sm">詳しく見る</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div class="border-t border-line">
    {siteContent.courses.map((course, index) => (
      <section id={course.id} class={`site-section scroll-mt-24 ${index % 2 === 1 ? 'bg-subtle' : ''}`}>
        <div class="site-container grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
          <div class={`lg:col-span-5 ${index % 2 === 1 ? 'lg:order-2' : ''}`}>
            <img src={course.photo} alt={`${course.name}レッスンのイメージ`} width="1000" height="750" class="aspect-[4/3] w-full object-cover" loading="lazy" decoding="async" />
            <p class="mt-3 text-xs text-ink-muted">写真はレッスンイメージです。</p>
          </div>
          <div class={`lg:col-span-7 ${index % 2 === 1 ? 'lg:order-1' : ''}`}>
            <p class="eyebrow">{String(index + 1).padStart(2, '0')} / {siteContent.courses.length}</p>
            <h2 class="section-title mb-4">{course.name}</h2>
            <p class="lead mb-6 text-ink-secondary">{course.description}</p>
            <dl class="mb-7 grid gap-5 border-y border-line py-5 sm:grid-cols-2">
              <div><dt class="mb-1 text-xs font-bold text-ink-muted">対象の目安</dt><dd class="font-bold text-brand">{course.ages}</dd></div>
              <div><dt class="mb-1 text-xs font-bold text-ink-muted">対応レベル</dt><dd class="text-sm leading-7 text-ink-secondary">{course.levels.join('・')}</dd></div>
            </dl>
            <ul class="mb-8 space-y-3">
              {course.features.map((feature) => <li class="flex gap-3 text-base text-ink-secondary"><span class="mt-3 h-1.5 w-1.5 flex-none bg-accent" aria-hidden="true"></span><span>{feature}</span></li>)}
            </ul>
            <ActionLink href={`/trial?instrument=${course.id}`}>このコースの体験を申し込む</ActionLink>
          </div>
        </div>
      </section>
    ))}
  </div>

  <section class="site-section bg-subtle">
    <div class="site-container-narrow">
      <SectionHeading title="コースを決めきれない方へ" description="楽器の経験や、演奏してみたい曲をフォームにご記入ください。体験前の一般的なご相談は、お問い合わせフォームでも受け付けています。" />
      <div class="flex flex-col gap-3 sm:flex-row"><ActionLink href="/pricing">料金プランを見る</ActionLink><ActionLink href="/contact" variant="secondary">一般のお問い合わせ</ActionLink></div>
    </div>
  </section>

  <CTASection title="自分に合う進め方を、体験で確かめる" description={`体験は${siteContent.trialDuration}、${siteContent.trialPriceExTax.toLocaleString('ja-JP')}円（税別）です。楽器を選ぶと申込フォームへ引き継がれます。`} />
</BaseLayout>
