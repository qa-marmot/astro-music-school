---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import StatusPanel from '../components/ui/StatusPanel.astro';
import ActionLink from '../components/ui/ActionLink.astro';
import CTASection from '../components/ui/CTASection.astro';
import { siteContent } from '../data/site';
---

<BaseLayout title="アクセス" description="教室の住所、最寄り駅、営業時間をご案内します。">
  <PageHeader title="アクセス" eyebrow="教室への行き方" description="正確な住所、最寄り駅、道順、営業時間を一つの情報源からご案内します。" />

  <section class="site-section">
    <div class="site-container">
      {siteContent.contact ? (
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-5">
            <SectionHeading title="教室情報" />
            <dl class="divide-y divide-line border-y border-line">
              <div class="grid gap-2 py-5 sm:grid-cols-[8rem_1fr]"><dt class="font-bold">住所</dt><dd class="text-ink-secondary">〒{siteContent.contact.postalCode}<br />{siteContent.contact.address}</dd></div>
              <div class="grid gap-2 py-5 sm:grid-cols-[8rem_1fr]"><dt class="font-bold">最寄り駅</dt><dd class="text-ink-secondary">{siteContent.contact.station}</dd></div>
              <div class="grid gap-2 py-5 sm:grid-cols-[8rem_1fr]"><dt class="font-bold">営業時間</dt><dd class="text-ink-secondary">{siteContent.contact.hours}</dd></div>
              <div class="grid gap-2 py-5 sm:grid-cols-[8rem_1fr]"><dt class="font-bold">休業日</dt><dd class="text-ink-secondary">{siteContent.contact.closed}</dd></div>
              <div class="grid gap-2 py-5 sm:grid-cols-[8rem_1fr]"><dt class="font-bold">連絡先</dt><dd class="break-words text-ink-secondary">{siteContent.contact.phone}<br />{siteContent.contact.email}</dd></div>
            </dl>
            {siteContent.contact.mapUrl && <div class="mt-6"><ActionLink href={siteContent.contact.mapUrl} variant="secondary">地図アプリで開く</ActionLink></div>}
          </div>
          <div class="lg:col-span-7">
            {siteContent.contact.mapEmbedUrl ? (
              <iframe src={siteContent.contact.mapEmbedUrl} title={`${siteContent.name}周辺地図`} class="aspect-[4/3] w-full border border-line" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            ) : <StatusPanel type="empty" title="地図を準備中です"><p>確認済みの地図URLを設定すると、ここに表示されます。</p></StatusPanel>}
          </div>
        </div>
      ) : (
        <div class="site-container-narrow">
          <StatusPanel type="empty" title="教室情報を確認中です">
            <p>架空の住所や経路は掲載していません。本番公開には、正確な住所、最寄り駅、道順、営業時間、連絡先の設定が必要です。</p>
          </StatusPanel>
          <div class="mt-8 text-center"><ActionLink href="/contact" variant="secondary">一般のお問い合わせ</ActionLink></div>
        </div>
      )}
    </div>
  </section>

  <section class="site-section bg-subtle">
    <div class="site-container-narrow">
      <SectionHeading title="教室写真と道順" description="本番では、駅から迷いやすい分岐を写真付きで案内し、実際の入口とレッスン室を掲載します。ストック写真を教室固有の写真として使用しません。" />
    </div>
  </section>
  <CTASection title="体験前の不安を相談する" description="通い方や当日の持ち物など、確認したいことがあればお知らせください。" secondaryHref="/contact" secondaryLabel="一般のお問い合わせ" />
</BaseLayout>
