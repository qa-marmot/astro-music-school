---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ActionLink from '../components/ui/ActionLink.astro';
import CTASection from '../components/ui/CTASection.astro';
import EditorialImage from '../components/media/EditorialImage.astro';
import { siteContent } from '../data/site';
import { siteImages } from '../data/images';
---

<BaseLayout title="アクセス" description="教室の住所、最寄り駅、営業時間をご案内します。">
  <PageHeader variant="compact" title="アクセス" description="所在地が確定している場合だけ、住所、最寄り駅、地図、入口までの道順をご案内します。" />

  {siteContent.contact ? (
    <section class="site-section">
      <div class="site-container grid items-start gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-6">
          <EditorialImage image={siteImages.accessRoom} aspect="3 / 2" sizes="(min-width: 1024px) 48vw, 100vw" treatment="plain" />
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
            <SectionHeading title="教室情報" spacing="compact" />
            <dl class="divide-y divide-line border-y border-line">
              <div class="grid gap-2 py-4 sm:grid-cols-[7rem_1fr]"><dt class="font-bold">住所</dt><dd class="text-ink-secondary">〒{siteContent.contact.postalCode}<br />{siteContent.contact.address}</dd></div>
              <div class="grid gap-2 py-4 sm:grid-cols-[7rem_1fr]"><dt class="font-bold">最寄り駅</dt><dd class="text-ink-secondary">{siteContent.contact.station}</dd></div>
              <div class="grid gap-2 py-4 sm:grid-cols-[7rem_1fr]"><dt class="font-bold">営業時間</dt><dd class="text-ink-secondary">{siteContent.contact.hours}</dd></div>
              <div class="grid gap-2 py-4 sm:grid-cols-[7rem_1fr]"><dt class="font-bold">休業日</dt><dd class="text-ink-secondary">{siteContent.contact.closed}</dd></div>
              <div class="grid gap-2 py-4 sm:grid-cols-[7rem_1fr]"><dt class="font-bold">連絡先</dt><dd class="break-words text-ink-secondary"><a href={`tel:${siteContent.contact.phone}`}>{siteContent.contact.phone}</a><br /><a href={`mailto:${siteContent.contact.email}`}>{siteContent.contact.email}</a></dd></div>
            </dl>
            {siteContent.contact.mapUrl && <div class="mt-6"><ActionLink href={siteContent.contact.mapUrl} variant="secondary">地図アプリで開く</ActionLink></div>}
        </div>
      </div>
    </section>
  ) : (
    <section class="site-section--compact">
      <div class="site-container-narrow border-y border-line py-7">
        <h2 class="mb-3 text-xl font-bold leading-8">所在地は公開データに設定されていません</h2>
        <p class="mb-5 text-base leading-8 text-ink-secondary">未確認の住所、最寄り駅、道順、地図は表示していません。所在地についてはお問い合わせください。</p>
        <ActionLink href="/contact" variant="secondary">所在地を問い合わせる</ActionLink>
      </div>
    </section>
  )}

  {siteContent.contact?.mapEmbedUrl && (
    <section class="site-section site-section--subtle">
      <div class="site-container grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <SectionHeading title="地図と道順" description="最寄り駅から入口まで、迷いやすい分岐を順にご案内します。" />
        </div>
        <iframe src={siteContent.contact.mapEmbedUrl} title={`${siteContent.name}周辺地図`} class="aspect-[4/3] w-full border border-line lg:col-span-8" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </section>
  )}

  <CTASection
    tone="quiet"
    align="left"
    title="体験当日の通い方について"
    description="所在地や入口、当日の持ち物など、確認したいことは一般お問い合わせからお送りください。"
    primaryHref="/contact"
    primaryLabel="通い方を問い合わせる"
    secondaryHref="/trial"
    secondaryLabel="体験内容を見る"
  />
</BaseLayout>
