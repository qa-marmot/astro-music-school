---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import FaqList from '../components/content/FaqList.astro';
import CTASection from '../components/ui/CTASection.astro';
import { isDemo, siteContent } from '../data/site';

const taxIncluded = Math.floor(siteContent.trialPriceExTax * 1.1).toLocaleString('ja-JP');
const categories = [
  {
    title: 'レッスンについて',
    items: [
      { q: '楽器が初めてでも受講できますか？', a: 'はい。構え方や楽譜の読み方など、必要な基礎から一つずつ進めます。経験や弾いてみたい曲を体験フォームでお知らせください。' },
      { q: '子どもと大人のどちらも受講できますか？', a: 'はい。コースごとに対象年齢の目安を設けています。お子さまは楽器のサイズや集中できる時間も体験時に確認し、大人の方は経験や生活のペースに合わせて進めます。' },
    ],
  },
  {
    title: '料金・通い方について',
    items: [
      { q: '体験レッスンの料金はいくらですか？', a: `税込${taxIncluded}円、所要時間は${siteContent.trialDuration}です。フォーム送信後に日程をご相談し、予約を確定します。` },
      { q: '教材費は月謝に含まれますか？', a: 'ライト・スタンダードプランは教材費が別途必要です。プレミアムプランは一部を含みます。必要な教材と金額は購入前にご案内します。' },
    ],
  },
  {
    title: '体験・お申し込みについて',
    items: [
      { q: '体験では何をしますか？', a: '経験や目標を伺い、実際に音を出しながら、今後の進め方をご相談します。先生との距離や説明の分かりやすさもご確認ください。' },
      { q: 'フォームを送れば予約は確定しますか？', a: 'いいえ。フォーム送信後に担当者が候補日時を確認し、双方で日時を確認した後に予約確定となります。' },
    ],
  },
];
const allItems = categories.flatMap((category) => category.items);
const faqJsonLd = !isDemo ? { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: allItems.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) } : undefined;
---

<BaseLayout title="よくあるご質問" description="レッスン、料金、体験申込についてのよくある質問をご案内します。" jsonLd={faqJsonLd}>
  <PageHeader variant="compact" title="よくあるご質問" description="初めて音楽を学ぶ方、保護者の方、大人になって再開する方から寄せられやすい質問をまとめました。" />
  <section class="site-section">
    <div class="site-container-narrow">
      <div class="space-y-14">
        {categories.map((category) => (
          <section>
            <SectionHeading title={category.title} spacing="compact" />
            <FaqList items={category.items} />
          </section>
        ))}
      </div>
    </div>
  </section>
  <CTASection
    tone="quiet"
    align="left"
    title="ここにない質問は、個別にお送りください"
    description="体験をご希望の方は体験申込へ、料金や通い方など一般的なご質問はお問い合わせへお進みください。"
    secondaryHref="/contact"
    secondaryLabel="一般的な質問をする"
  />
</BaseLayout>
