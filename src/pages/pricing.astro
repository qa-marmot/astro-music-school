---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ActionLink from '../components/ui/ActionLink.astro';
import FaqList from '../components/content/FaqList.astro';
import CTASection from '../components/ui/CTASection.astro';
import { siteContent } from '../data/site';

const yen = (value: number) => value.toLocaleString('ja-JP');
const taxIncluded = (value: number) => Math.floor(value * 1.1);
const pricingFaqs = [
  { q: '教材費は月謝に含まれますか？', a: 'ライト・スタンダードプランは教材費が別途必要です。プレミアムプランは一部を含みます。必要な教材と金額は購入前にご案内します。' },
  { q: '欠席した場合、振替できますか？', a: 'ライトプランは月1回まで、スタンダードプランは月2回までの設定です。プレミアムプランの扱いを含む詳しい条件は、お申し込み前にお問い合わせください。' },
];
---

<BaseLayout title="料金プラン" description="体験レッスンと月額レッスンプランの料金をご案内します。">
  <PageHeader variant="compact" title="料金プラン" description="月2回から月4回以上まで。練習できる時間と目標に合わせて、無理のない通い方をお選びください。" />

  <section class="site-section">
    <div class="site-container">
      <SectionHeading title="体験レッスン" description={`所要時間は${siteContent.trialDuration}。フォーム送信後に日程をご相談し、予約を確定します。`} />
      <div class="grid gap-5 border-y border-line py-7 md:grid-cols-[1fr_auto] md:items-end">
        <div>
          <p class="mb-1 text-sm font-bold text-accent-strong">税込総額</p>
          <p class="mb-2 text-4xl font-bold tabular text-brand">{yen(taxIncluded(siteContent.trialPriceExTax))}円</p>
          <p class="mb-0 text-sm text-ink-secondary">税別 {yen(siteContent.trialPriceExTax)}円／教材費などの追加費用は申込前にご確認ください。</p>
        </div>
        <ActionLink href="/trial">体験レッスンを申し込む</ActionLink>
      </div>
    </div>
  </section>

  <section class="site-section site-section--subtle">
    <div class="site-container">
      <SectionHeading title="月額プランを比べる" description="税込額を主表示しています。教材費など、月謝以外に必要な項目もあわせてご確認ください。" />

      <div class="hidden overflow-x-auto md:block">
        <table class="w-full border-collapse text-left">
          <thead>
            <tr class="border-y border-line">
              <th class="w-1/4 px-4 py-4 text-sm text-ink-secondary">プラン</th>
              {siteContent.pricing.map((plan) => <th class={`px-4 py-4 align-top ${plan.recommended ? 'border-t-2 border-accent' : ''}`}><span class="block text-lg text-ink">{plan.name}</span>{plan.recommended && <span class="mt-1 block text-xs text-accent-strong">継続して学びたい方へ</span>}</th>)}
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-line"><th class="px-4 py-4 text-sm">月額・税込</th>{siteContent.pricing.map((plan) => <td class="px-4 py-4 text-2xl font-bold tabular text-brand">{yen(taxIncluded(plan.monthlyPriceExTax))}円</td>)}</tr>
            <tr class="border-b border-line"><th class="px-4 py-4 text-sm">回数</th>{siteContent.pricing.map((plan) => <td class="px-4 py-4 tabular">{plan.frequency}</td>)}</tr>
            <tr class="border-b border-line"><th class="px-4 py-4 text-sm">1回の時間</th>{siteContent.pricing.map((plan) => <td class="px-4 py-4 tabular">{plan.duration}</td>)}</tr>
            <tr class="border-b border-line"><th class="px-4 py-4 text-sm">別途費用・条件</th>{siteContent.pricing.map((plan) => <td class="px-4 py-4 align-top text-sm leading-7 text-ink-secondary">{plan.features.join('／')}</td>)}</tr>
            <tr><th class="px-4 py-5"><span class="sr-only">申込み</span></th>{siteContent.pricing.map((plan) => <td class="px-4 py-5"><ActionLink href="/trial" variant={plan.recommended ? 'primary' : 'secondary'} size="sm">体験で相談する</ActionLink></td>)}</tr>
          </tbody>
        </table>
      </div>

      <div class="space-y-8 md:hidden">
        {siteContent.pricing.map((plan) => (
          <article class={`border-y py-6 ${plan.recommended ? 'border-brand' : 'border-line'}`}>
            {plan.recommended && <p class="mb-2 text-xs font-bold text-accent-strong">継続して学びたい方へ</p>}
            <h3 class="mb-3 text-2xl font-bold">{plan.name}</h3>
            <p class="mb-1 text-3xl font-bold tabular text-brand">税込 {yen(taxIncluded(plan.monthlyPriceExTax))}円</p>
            <p class="mb-5 text-xs text-ink-secondary">月額／税別 {yen(plan.monthlyPriceExTax)}円</p>
            <dl class="mb-5 grid grid-cols-2 gap-4 border-y border-line py-4 text-sm">
              <div><dt class="text-ink-secondary">回数</dt><dd class="mt-1 font-bold">{plan.frequency}</dd></div>
              <div><dt class="text-ink-secondary">1回</dt><dd class="mt-1 font-bold">{plan.duration}</dd></div>
            </dl>
            <p class="mb-5 text-sm leading-7 text-ink-secondary">{plan.features.join('／')}</p>
            <ActionLink href="/trial" variant={plan.recommended ? 'primary' : 'secondary'}>体験で相談する</ActionLink>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="site-section">
    <div class="site-container-narrow">
      <SectionHeading title="教材費と振替について" description="現在の料金データから確認できる条件をまとめています。" />
      <FaqList items={pricingFaqs} />
    </div>
  </section>

  <CTASection
    tone="quiet"
    align="left"
    title="通い方に迷うときは"
    description="体験では演奏だけでなく、練習できる時間や目標に合う回数もご相談いただけます。料金だけのご質問はお問い合わせからお送りください。"
    secondaryHref="/contact"
    secondaryLabel="料金について質問する"
  />
</BaseLayout>
