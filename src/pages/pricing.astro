---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ActionLink from '../components/ui/ActionLink.astro';
import FaqList from '../components/content/FaqList.astro';
import CTASection from '../components/ui/CTASection.astro';
import StatusPanel from '../components/ui/StatusPanel.astro';
import { siteContent, isDemo } from '../data/site';

const yen = (value: number) => value.toLocaleString('ja-JP');
const pricingFaqs = [
  { q: '教材費は月謝に含まれますか？', a: '教材費は原則として別料金のサンプル設定です。必要な教材と費用は購入前にご案内します。' },
  { q: '欠席した場合、振替できますか？', a: 'プランごとに振替回数を設定する想定です。期限や連絡方法を含む正式な規定は、本番公開前にご確認ください。' },
  { q: '休会・退会はいつまでに連絡が必要ですか？', a: 'この条件は現在未確定です。本番サイトでは締切日、手続き方法、費用の有無を明記します。' },
];
---

<BaseLayout title="料金プラン" description="体験レッスンと月額レッスンプランの料金をご案内します。">
  <PageHeader title="料金プラン" eyebrow="分かりやすい費用案内" description="回数と目標から選べる3つのプラン。まず必要な費用を確認し、無理のない通い方をご検討ください。" />

  <section class="site-section">
    <div class="site-container">
      <SectionHeading title="体験・入会時の費用" description="表示価格はデモ用のサンプルです。本番では税込総額、入会金、教材費などの確定情報を一元管理して表示します。" />
      <div class="grid gap-px border-y border-line bg-line md:grid-cols-2">
        <div class="bg-canvas py-7 md:px-8">
          <p class="mb-2 text-sm font-bold text-brand">体験レッスン</p>
          <p class="mb-2 font-serif text-3xl font-bold text-ink">{yen(siteContent.trialPriceExTax)}円 <span class="font-sans text-sm">（税別）</span></p>
          <p class="mb-0 text-sm leading-7 text-ink-secondary">税込 {yen(Math.floor(siteContent.trialPriceExTax * 1.1))}円・{siteContent.trialDuration}。申込前に内容をご確認ください。</p>
        </div>
        <div class="bg-canvas py-7 md:px-8">
          <p class="mb-2 text-sm font-bold text-brand">入会金・その他費用</p>
          <p class="mb-2 text-xl font-bold text-ink">正式条件を確認中</p>
          <p class="mb-0 text-sm leading-7 text-ink-secondary">架空の入会金や設備費は表示していません。教材費など別途必要な項目を本番公開前に明記します。</p>
        </div>
      </div>
    </div>
  </section>

  <section class="site-section bg-subtle">
    <div class="site-container">
      <SectionHeading title="月額3プラン" description="月謝はサンプルです。スタンダードは、月3回で上達を継続したい方に向けた構成です。" />
      <div class="grid items-stretch gap-5 lg:grid-cols-3">
        {siteContent.pricing.map((plan) => (
          <article class={`content-card flex flex-col p-6 sm:p-7 ${plan.recommended ? 'border-brand' : ''}`}>
            {plan.recommended && <p class="mb-4 self-start bg-brand px-3 py-1 text-xs font-bold text-canvas">月3回で継続したい方向け</p>}
            <h3 class="mb-1 text-xl font-bold">{plan.name}</h3>
            <p class="mb-5 min-h-14 text-sm leading-7 text-ink-secondary">{plan.audience}</p>
            <p class="mb-1 font-serif text-3xl font-bold text-brand">{yen(plan.monthlyPriceExTax)}円</p>
            <p class="mb-5 text-xs text-ink-muted">月額・税別 / 税込 {yen(Math.floor(plan.monthlyPriceExTax * 1.1))}円</p>
            <dl class="mb-6 grid grid-cols-2 border-y border-line py-4 text-sm">
              <div><dt class="text-ink-muted">回数</dt><dd class="mt-1 font-bold">{plan.frequency}</dd></div>
              <div><dt class="text-ink-muted">1回</dt><dd class="mt-1 font-bold">{plan.duration}</dd></div>
            </dl>
            <ul class="mb-7 flex-1 space-y-3 text-sm leading-7 text-ink-secondary">
              {plan.features.map((feature) => <li class="flex gap-3"><span class="mt-3 h-1.5 w-1.5 flex-none bg-accent"></span><span>{feature}</span></li>)}
            </ul>
            <ActionLink href="/trial" variant={plan.recommended ? 'primary' : 'secondary'} class="w-full">体験を申し込む</ActionLink>
          </article>
        ))}
      </div>
      {isDemo && <div class="mt-6"><StatusPanel type="warning" title="サンプル料金です"><p class="mb-0">実際の料金として利用する前に、税区分、入会金、教材費、振替、休会・退会条件を確認してください。</p></StatusPanel></div>}
    </div>
  </section>

  <section class="site-section">
    <div class="site-container-narrow">
      <SectionHeading title="支払い・振替・休会について" description="費用と通い方に関わる条件は、体験前に確認できることが大切です。未確定事項を推測で表示しません。" />
      <FaqList items={pricingFaqs} />
    </div>
  </section>

  <CTASection title="料金とレッスンの相性を体験で確認する" description={`体験は${siteContent.trialDuration}、${yen(siteContent.trialPriceExTax)}円（税別）。フォームからご希望の楽器をお知らせください。`} secondaryHref="/contact" secondaryLabel="料金について問い合わせる" />
</BaseLayout>
