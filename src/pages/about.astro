---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import CTASection from '../components/ui/CTASection.astro';
import EditorialImage from '../components/media/EditorialImage.astro';
import { siteContent } from '../data/site';
import { siteImages } from '../data/images';

const principles = [
  {
    title: '目的を、最初に言葉にする',
    body: '好きな曲、困っていること、生活のペースを伺います。目標は先生が一方的に決めず、続けられる形へ一緒に整えます。',
  },
  {
    title: '基礎を、音楽の中で確かめる',
    body: '姿勢や指づかいを切り離して覚えるだけでなく、曲の音がどう変わるかを聴きながら基礎の意味を確かめます。',
  },
  {
    title: '振り返り、次回を調整する',
    body: 'できたことと次に試すことを短く整理します。練習時間や目標が変わったときは、教材や進度も見直します。',
  },
];
---

<BaseLayout title="教室紹介" description="Harmony Music Schoolが個人レッスンで大切にしていることをご紹介します。">
  <section class="about-intro">
    <div class="site-container-wide about-intro__inner">
      <div class="about-intro__copy">
        <h1 class="page-title">教室紹介</h1>
        <p class="lead text-ink-secondary">できたことを一緒に見つけ、次の一歩を急がない。音楽を長く楽しむための個人レッスンを大切にしています。</p>
        <SectionHeading title="一人ひとりの音が育つ、静かな時間" spacing="compact" />
        <div class="measure space-y-5 text-base leading-8 text-ink-secondary">
          <p>同じ楽器、同じ曲でも、目標や心地よい進み方は人によって違います。まずは話を聞き、その日の状態を確かめながら、無理のない課題を一緒に決めます。</p>
          <p>弾けるようになることだけを急がず、音を聴くこと、試すこと、変化に気づくことを大切にします。初めての方にも、もう一度音楽を始めたい方にも開かれた教室を目指しています。</p>
        </div>
      </div>
      <div class="about-intro__image">
        <EditorialImage image={siteImages.aboutGuidance} aspect="4 / 5" mobileAspect="5 / 4" sizes="(min-width: 1024px) 42vw, 100vw" treatment="plain" />
      </div>
    </div>
  </section>

  <section class="site-section site-section--subtle">
    <div class="site-container">
      <SectionHeading title="指導で大切にすること" description="教材や進度を先に決めるのではなく、対話と観察からレッスンを組み立てます。" />
      <div class="border-t border-line">
        {principles.map((principle) => (
          <article class="grid gap-3 border-b border-line py-7 md:grid-cols-12 md:gap-8">
            <h3 class="text-xl font-bold leading-8 text-ink md:col-span-4">{principle.title}</h3>
            <p class="mb-0 text-base leading-8 text-ink-secondary md:col-span-7 md:col-start-6">{principle.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="site-section">
    <div class="site-container grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <SectionHeading title="その場で音を聴き、言葉を交わす" spacing="compact" />
      </div>
      <div class="space-y-5 text-base leading-8 text-ink-secondary lg:col-span-6 lg:col-start-7">
        <p>レッスンは、演奏を聴いて気づいたことを短く伝え、もう一度試す流れを大切にします。分からないまま進めず、質問しやすい間をつくります。</p>
        <p>ご自宅で取り組める量も一緒に考えます。毎日長く練習することを前提にせず、生活の中で音楽に戻ってこられる形を探します。</p>
      </div>
    </div>
  </section>

  {siteContent.instructors.length > 0 && (
    <section class="site-section border-t border-line">
      <div class="site-container">
        <SectionHeading title="講師" description="担当楽器と指導方針をご紹介します。" />
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {siteContent.instructors.map((instructor) => (
            <article class="border-t-2 border-accent pt-5">
              {instructor.photo && <EditorialImage image={instructor.photo} aspect="4 / 5" sizes="(min-width: 1024px) 30vw, 100vw" />}
              <p class="mb-1 mt-5 text-sm font-bold text-accent-strong">{instructor.role}</p>
              <h3 class="mb-3 text-xl font-bold">{instructor.name}</h3>
              <p class="mb-0 text-sm leading-7 text-ink-secondary">{instructor.bio}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <CTASection
    tone="quiet"
    align="left"
    title="先生との相性や、説明の分かりやすさを体験で"
    description={`体験は${siteContent.trialDuration}。経験や目標を伺い、実際に音を出しながら進め方をご相談します。`}
    secondaryHref="/contact"
    secondaryLabel="一般的な質問をする"
  />

  <style>
    .about-intro { border-bottom: var(--rule-hair) solid var(--color-rule); }
    .about-intro__inner { display: grid; gap: var(--space-xl); padding-block: var(--space-xl) var(--space-section); }
    .about-intro__copy { align-self: center; }
    .about-intro__copy > .lead { margin-block: var(--space-md) var(--space-2xl); }
    .about-intro__image { min-width: 0; }
    @media (min-width: 60rem) {
      .about-intro__inner { grid-template-columns: repeat(12, minmax(0, 1fr)); align-items: center; }
      .about-intro__copy { grid-column: 1 / span 6; }
      .about-intro__image { grid-column: 8 / -1; }
    }
  </style>
</BaseLayout>
