---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import CTASection from '../components/ui/CTASection.astro';
import StatusPanel from '../components/ui/StatusPanel.astro';
import { siteContent, isDemo } from '../data/site';
---

<BaseLayout
  title="教室紹介"
  description="Harmony Music Schoolが個人レッスンで大切にしていることをご紹介します。"
>
  <PageHeader
    title="教室紹介"
    eyebrow="私たちの考え方"
    description="できたことを一緒に見つけ、次の一歩を急がない。音楽を長く楽しむための個人レッスンを大切にしています。"
  />

  <section class="site-section">
    <div class="site-container grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <SectionHeading title="一人ひとりの音が育つ場所" description="同じ楽器、同じ曲でも、目標や心地よい進み方は人によって違います。まずは話を聞き、その日の状態を確かめながら、無理のない課題を一緒に決めます。" />
        <p class="body-copy mb-0">弾けるようになることだけを急がず、音を聴くこと、試すこと、できた変化に気づくことを大切にします。初心者の方にも、もう一度音楽を始めたい方にも、本格的に学びたい方にも開かれた教室を目指しています。</p>
      </div>
      <figure class="lg:col-span-5">
        <img
          src="/images/lesson-hero.jpg"
          alt="ピアノの個人レッスンを受ける生徒と指導者のイメージ"
          width="800"
          height="1000"
          class="aspect-[5/4] w-full object-cover"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="mt-3 text-xs leading-6 text-ink-muted">写真はレッスンイメージです。</figcaption>
      </figure>
    </div>
  </section>

  <section class="site-section bg-subtle">
    <div class="site-container">
      <SectionHeading title="指導で大切にする3つのこと" description="教材や進度を先に決めるのではなく、対話からレッスンを組み立てます。" />
      <div class="grid gap-px border-y border-line bg-line md:grid-cols-3">
        <article class="bg-subtle py-8 md:px-7">
          <p class="eyebrow">01</p>
          <h3 class="mb-3 text-xl font-bold">目的を言葉にする</h3>
          <p class="mb-0 text-base leading-8 text-ink-secondary">好きな曲、困っていること、生活のペースを伺い、続けられる目標を一緒に考えます。</p>
        </article>
        <article class="bg-subtle py-8 md:px-7">
          <p class="eyebrow">02</p>
          <h3 class="mb-3 text-xl font-bold">基礎と楽しさをつなぐ</h3>
          <p class="mb-0 text-base leading-8 text-ink-secondary">基礎練習の意味を曲の中で確かめながら、上達の手応えが見える進め方を選びます。</p>
        </article>
        <article class="bg-subtle py-8 md:px-7">
          <p class="eyebrow">03</p>
          <h3 class="mb-3 text-xl font-bold">振り返って調整する</h3>
          <p class="mb-0 text-base leading-8 text-ink-secondary">できたことと次に試すことを整理し、練習時間や目標の変化に合わせて内容を調整します。</p>
        </article>
      </div>
    </div>
  </section>

  <section class="site-section">
    <div class="site-container">
      <SectionHeading title="講師・教室について" description="本番サイトでは、確認済みの講師情報と実際の教室写真だけを掲載します。" />
      {siteContent.instructors.length > 0 ? (
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {siteContent.instructors.map((instructor) => (
            <article class="content-card overflow-hidden">
              <img src={instructor.photo} alt={`${instructor.name}講師`} width="640" height="800" class="aspect-[4/5] w-full object-cover" loading="lazy" />
              <div class="p-6">
                <p class="mb-1 text-sm font-bold text-accent-strong">{instructor.role}</p>
                <h3 class="mb-3 text-xl font-bold">{instructor.name}</h3>
                <p class="mb-0 text-sm leading-7 text-ink-secondary">{instructor.bio}</p>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <StatusPanel type="empty" title="確認済みの講師情報を準備中です">
          <p class="mb-0">架空の氏名やストック人物写真は掲載していません。デモでは、個人レッスンの情報設計と表示例をご確認いただけます。</p>
        </StatusPanel>
      )}
      {isDemo && <p class="mt-4 text-sm leading-7 text-ink-muted">このページはサンプルです。本番では講師の氏名・担当・略歴と、実際の教室・設備写真の確認が必要です。</p>}
    </div>
  </section>

  <CTASection title="まずは、話しながら音を出してみませんか" description={`体験は${siteContent.trialDuration}、${siteContent.trialPriceExTax.toLocaleString('ja-JP')}円（税別）。経験や目標を伺い、レッスンの進め方をご提案します。`} secondaryHref="/contact" secondaryLabel="一般のお問い合わせ" />
</BaseLayout>
