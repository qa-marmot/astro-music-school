---
import BaseLayout from '../layouts/BaseLayout.astro';
import ActionLink from '../components/ui/ActionLink.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import CTASection from '../components/ui/CTASection.astro';
import FaqList from '../components/content/FaqList.astro';
import TrialSteps from '../components/content/TrialSteps.astro';
import EditorialImage from '../components/media/EditorialImage.astro';
import { audienceGuides, siteContent } from '../data/site';
import { siteImages } from '../data/images';

const faqItems = [
  { q: '楽器が初めてでも参加できますか？', a: 'はい。楽譜の読み方や楽器の構え方など、必要な基礎から目標に合わせて進めます。' },
  { q: '体験レッスンでは何をしますか？', a: `最初にご希望を伺い、${siteContent.trialDuration}のレッスンを体験していただきます。終了後に今後の進め方をご相談します。` },
];

const standardPlan = siteContent.pricing.find((plan) => plan.recommended) ?? siteContent.pricing[0];
const taxIncluded = (price: number) => Math.floor(price * 1.1).toLocaleString('ja-JP');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicSchool',
  name: siteContent.name,
  url: siteContent.siteUrl,
  description: '一人ひとりの目標に合わせた個人音楽レッスン',
};
---

<BaseLayout
  description="ピアノ・ギター・バイオリン・声楽を、一人ひとりの目標に合わせて学ぶ個人音楽レッスン。体験レッスン受付中。"
  jsonLd={jsonLd}
>
  <section class="home-hero">
    <div class="site-container-wide home-hero__inner">
      <div class="home-hero__copy">
        <p class="home-hero__kicker">子どもから大人まで、一対一で学ぶ音楽教室です。</p>
        <h1 class="home-hero-title">弾きたい気持ちから、<br />あなたの音を育てる。</h1>
        <p class="lead text-ink-secondary">
          ピアノ・ギター・バイオリン・声楽。初めての一音も、もう一度始める時間も、一人ひとりの目標とペースに合わせます。
        </p>
        <div class="home-hero__actions">
          <ActionLink href="/trial" size="lg" testId="hero-trial-btn">体験を申し込む</ActionLink>
          <ActionLink href="/lessons" variant="secondary" size="lg" testId="hero-lessons-btn">レッスンを見る</ActionLink>
        </div>
      </div>
      <div class="home-hero__image">
        <EditorialImage
          image={siteImages.homeHero}
          aspect="4 / 3"
          mobileAspect="5 / 4"
          sizes="(min-width: 1280px) 58vw, (min-width: 960px) 54vw, 100vw"
          loading="eager"
          fetchpriority="high"
          treatment="bleed"
        />
      </div>
      <dl class="home-hero__facts">
          <div><dt>体験時間</dt><dd>{siteContent.trialDuration}</dd></div>
          <div><dt>体験料金</dt><dd>税込 {taxIncluded(siteContent.trialPriceExTax)}円</dd></div>
          <div><dt>楽器</dt><dd>{siteContent.courses.map((course) => course.name).join('・')}</dd></div>
      </dl>
    </div>
  </section>

  <section class="site-section--feature">
    <div class="site-container">
      <SectionHeading title="始める理由に合う、確かめ方があります" description="体験レッスンでは、演奏の上手さだけでなく、通い方や目標まで含めてご相談いただけます。" />
      <div class="audience-guides">
        {audienceGuides.map((guide, index) => (
          <article class="audience-guides__item">
            <span class="audience-guides__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3>{guide.title}</h3>
            <p>{guide.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="site-section site-section--subtle">
    <div class="site-container home-guidance">
      <div class="home-guidance__image">
        <EditorialImage image={siteImages.homeGuidance} aspect="3 / 2" sizes="(min-width: 1024px) 58vw, 100vw" treatment="bleed" />
      </div>
      <div class="home-guidance__copy">
        <p class="home-guidance__phrase">音を聴く距離で、伝える。</p>
        <SectionHeading title="話を聞き、手元を見て、次に取り組むことを一緒に決めます" spacing="compact" />
        <div class="measure space-y-5 text-base leading-8 text-ink-secondary">
          <p>弾きたい曲、音楽経験、練習できる時間を伺ってから、その日に取り組むことを整理します。</p>
          <p>基礎を急いで終わらせるのではなく、音の変化をその場で確かめます。体験は、先生との距離や説明の分かりやすさを見ていただく時間でもあります。</p>
        </div>
        <div class="mt-7"><ActionLink href="/about" variant="secondary">指導の考え方を読む</ActionLink></div>
      </div>
    </div>
  </section>

  <section class="site-section--feature quiet-rule">
    <div class="site-container">
      <SectionHeading title="4つの個人レッスン" description="興味のある楽器から、対象の目安とレッスン内容をご確認ください。" />
      <div class="course-gallery">
        {siteContent.courses.map((course, index) => (
          <article class={`course-gallery__item course-gallery__item--${index + 1}`}>
            <a href={`/lessons#${course.id}`}>
              <EditorialImage image={course.photo} aspect="4 / 3" sizes="(min-width: 1024px) 52vw, 100vw" treatment="plain" />
              <div class="course-gallery__copy">
                <div>
                  <h3>{course.name}</h3>
                  <p class="course-gallery__ages">{course.ages}</p>
                </div>
                <p>{course.summary}</p>
                <span>内容を見る <span aria-hidden="true">→</span></span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="site-section">
    <div class="site-container">
      <SectionHeading title="体験レッスンまでの流れ" description="お申し込み後に日程を調整します。フォーム送信だけで予約は確定しません。" />
      <TrialSteps />
      <div class="mt-8"><ActionLink href="/trial" variant="secondary">体験の内容と持ち物を見る</ActionLink></div>
    </div>
  </section>

  <section class="site-section site-section--subtle">
    <div class="site-container home-decisions">
      <div class="home-decisions__price">
        <SectionHeading title="通い方と料金の目安" description="月2回から月4回以上まで、練習時間と目標に合わせて選べます。" spacing="compact" />
        <div class="border-y border-line py-6 sm:flex sm:items-end sm:justify-between sm:gap-8">
          <div>
            <p class="mb-1 text-sm font-bold text-accent-strong">{standardPlan.name}</p>
            <p class="home-decisions__amount">税込 {taxIncluded(standardPlan.monthlyPriceExTax)}円</p>
            <p class="mb-0 text-sm text-ink-secondary">{standardPlan.frequency}・1回{standardPlan.duration}／教材費別途</p>
          </div>
          <div class="mt-5 sm:mt-0"><ActionLink href="/pricing" variant="secondary">すべての料金を見る</ActionLink></div>
        </div>
      </div>
      <div class="home-decisions__faq">
        <SectionHeading title="体験前によくあるご質問" description="初めての方が気になりやすい2点です。" spacing="compact" />
        <FaqList items={faqItems} />
        <div class="mt-7"><ActionLink href="/faq" variant="tertiary">すべての質問を見る →</ActionLink></div>
      </div>
    </div>
  </section>

  <CTASection
    title="まずは、音を出しながら話してみませんか"
    description={`体験は${siteContent.trialDuration}、税込${taxIncluded(siteContent.trialPriceExTax)}円。経験や目標を伺い、無理のない始め方をご案内します。`}
    secondaryHref="/contact"
    secondaryLabel="質問してから検討する"
    primaryTestId="cta-trial-btn"
  />

  <style>
    .home-hero { border-bottom: var(--rule-hair) solid var(--color-rule); background: var(--color-paper); }
    .home-hero__inner { display: grid; gap: var(--space-lg); padding-block: var(--space-lg) var(--space-2xl); }
    .home-hero__copy { position: relative; z-index: var(--z-raised); align-self: center; }
    .home-hero__kicker { margin-block-end: var(--space-sm); color: var(--color-accent-dark); font-size: var(--text-sm); font-weight: 700; }
    .home-hero h1 { max-width: 10em; margin-block-end: var(--space-md); color: var(--color-ink); font-size: var(--text-display); font-weight: 500; letter-spacing: -.045em; line-height: 1.05; }
    .home-hero .lead { margin-block-end: var(--space-lg); }
    .home-hero__actions { display: flex; flex-direction: column; gap: var(--space-xs); }
    .home-hero__image { min-width: 0; }
    .home-hero__facts { display: grid; gap: var(--space-sm); margin: 0; padding-block: var(--space-md); border-block: var(--rule-hair) solid var(--color-rule); color: var(--color-ink-2); font-size: var(--text-sm); }
    .home-hero__facts > div { min-width: 0; }
    .home-hero__facts dt { color: var(--color-brand); font-weight: 700; }
    .home-hero__facts dd { margin: 0; }
    .audience-guides { border-top: var(--rule-hair) solid var(--color-rule-2); }
    .audience-guides__item { display: grid; gap: var(--space-sm); padding-block: var(--space-lg); border-bottom: var(--rule-hair) solid var(--color-rule); }
    .audience-guides__number { color: var(--color-accent-dark); font-family: var(--font-display); font-size: 1.75rem; font-variant-numeric: tabular-nums; line-height: 1; }
    .audience-guides h3 { margin: 0; color: var(--color-ink); font-size: clamp(1.125rem, 2vw, 1.35rem); line-height: 1.55; }
    .audience-guides p { margin: 0; color: var(--color-ink-2); line-height: 1.8; }
    .home-guidance { display: grid; gap: var(--space-xl); align-items: center; }
    .home-guidance__image, .home-guidance__copy { min-width: 0; }
    .home-guidance__phrase { width: fit-content; margin-block-end: var(--space-lg); padding-block-end: var(--space-2xs); border-bottom: var(--rule-fine) solid var(--color-accent); color: var(--color-brand); font-family: var(--font-display); font-size: clamp(1.35rem, 3vw, 2rem); font-weight: 500; line-height: 1.45; }
    .course-gallery { display: grid; gap: var(--space-2xl) var(--space-lg); }
    .course-gallery__item, .course-gallery__item a { min-width: 0; }
    .course-gallery__item a { display: block; color: inherit; text-decoration: none; }
    .course-gallery__copy { display: grid; gap: var(--space-md); padding-block: var(--space-md); border-bottom: var(--rule-hair) solid var(--color-rule-2); }
    .course-gallery h3 { margin-block-end: var(--space-2xs); color: var(--color-ink); font-size: var(--text-xl); line-height: 1.3; }
    .course-gallery p { margin: 0; color: var(--color-ink-2); font-size: var(--text-sm); line-height: 1.8; }
    .course-gallery__ages { font-weight: 700; }
    .course-gallery__copy > span { color: var(--color-brand); font-size: var(--text-sm); font-weight: 700; white-space: nowrap; }
    .home-decisions { display: grid; gap: var(--space-2xl); }
    .home-decisions__amount { margin-block: var(--space-2xs); color: var(--color-brand); font-size: clamp(1.75rem, 4vw, 2.5rem); font-variant-numeric: tabular-nums; font-weight: 700; line-height: 1.2; }
    @media (min-width: 40rem) {
      .home-hero__actions { flex-direction: row; }
      .home-hero__facts { grid-template-columns: 1fr 1fr 1.6fr; }
      .course-gallery__copy { grid-template-columns: minmax(9rem, 1fr) minmax(0, 1.5fr) auto; align-items: start; }
    }
    @media (min-width: 60rem) {
      .home-hero__inner { grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--space-lg); min-height: clamp(34rem, 75dvh, 43rem); align-items: center; padding-block: var(--space-lg) var(--space-2xl); }
      .home-hero__copy { grid-column: 1 / span 6; grid-row: 1; margin-inline-end: calc(var(--space-xl) * -1); padding: var(--space-xl) var(--space-xl) var(--space-xl) 0; background: var(--color-paper); }
      .home-hero__image { grid-column: 6 / -1; grid-row: 1; }
      .home-hero__facts { grid-column: 1 / -1; grid-row: 2; }
      .home-hero .lead { max-width: 42ch; }
      .audience-guides__item { grid-template-columns: 5rem minmax(12rem, 4fr) minmax(0, 6fr); align-items: start; gap: var(--space-lg); }
      .home-guidance { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-3xl); }
      .course-gallery { grid-template-columns: repeat(12, minmax(0, 1fr)); }
      .course-gallery__item--1, .course-gallery__item--4 { grid-column: span 7; }
      .course-gallery__item--2, .course-gallery__item--3 { grid-column: span 5; }
      .course-gallery__item--2 { padding-block-start: var(--space-2xl); }
      .course-gallery__item--3 { padding-block-start: var(--space-xl); }
      .home-decisions { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-3xl); }
      .home-decisions__faq { padding-inline-start: var(--space-xl); border-inline-start: var(--rule-hair) solid var(--color-rule-2); }
    }
    @media (hover: hover) and (pointer: fine) {
      .course-gallery__item a:hover .course-gallery__copy > span { color: var(--color-brand-dark); }
    }
  </style>
</BaseLayout>
