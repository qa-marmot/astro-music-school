---
import BaseLayout from '../layouts/BaseLayout.astro';
import ActionLink from '../components/ui/ActionLink.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import CTASection from '../components/ui/CTASection.astro';
import FaqList from '../components/content/FaqList.astro';
import { isDemo, siteContent } from '../data/site';

const faqItems = [
  { q: '楽器が初めてでも参加できますか？', a: 'はい。楽譜の読み方や楽器の構え方など、必要な基礎から目標に合わせて進める想定です。' },
  { q: '体験レッスンでは何をしますか？', a: `ご希望を伺い、${siteContent.trialDuration}のレッスンを体験していただく想定です。終了後にコースや通い方をご案内します。` },
  { q: '子どもと大人のどちらも受講できますか？', a: 'コースごとに対象年齢を設け、子どもから大人まで検討できる構成です。詳しくはレッスンページをご確認ください。' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicSchool',
  name: siteContent.name,
  url: siteContent.siteUrl,
  description: '一人ひとりの目標に合わせた個人音楽レッスン',
};
---

<BaseLayout
  description="ピアノ・ギター・バイオリン・声楽を、一人ひとりの目標に合わせて学ぶ個人音楽レッスン。体験レッスン受付中。"
  jsonLd={jsonLd}
  preloadImage="/images/lesson-hero.jpg"
>
  <section class="border-b border-line bg-canvas">
    <div class="site-container-wide grid items-center gap-10 py-12 lg:grid-cols-12 lg:gap-14 lg:py-20">
      <div class="lg:col-span-7">
        <p class="eyebrow">初心者から経験者までの個人レッスン</p>
        <h1 class="display-title mb-6 text-ink">弾きたい気持ちから、<br class="hidden sm:block" />あなたの音を育てる。</h1>
        <p class="lead mb-8 text-ink-secondary">
          ピアノ・ギター・バイオリン・声楽。子どもから大人まで、目標とペースに合わせて音楽を学べる教室です。
        </p>
        <div class="mb-7 flex flex-col gap-3 sm:flex-row sm:items-center">
          <ActionLink href="/trial" size="lg" testId="hero-trial-btn">体験レッスン（3,000円）を申し込む</ActionLink>
          <ActionLink href="/lessons" variant="secondary" size="lg" testId="hero-lessons-btn">レッスンを見る</ActionLink>
        </div>
        <dl class="flex flex-wrap gap-x-8 gap-y-3 border-t border-line pt-5 text-sm text-ink-secondary">
          <div><dt class="inline font-bold text-ink">体験時間：</dt><dd class="inline">{siteContent.trialDuration}</dd></div>
          <div><dt class="inline font-bold text-ink">料金：</dt><dd class="inline">3,000円（税別）</dd></div>
          <div><dt class="inline font-bold text-ink">コース：</dt><dd class="inline">4種類</dd></div>
        </dl>
      </div>
      <div class="lg:col-span-5">
        <figure class="border border-line bg-subtle p-2">
          <img
            src="/images/lesson-hero.jpg"
            alt="ピアノの個人レッスンのイメージ"
            width="800"
            height="1000"
            class="aspect-[5/4] h-full w-full object-cover lg:aspect-[4/5]"
            fetchpriority="high"
          />
          <figcaption class="px-2 pb-1 pt-3 text-xs text-ink-muted">レッスンイメージ（サンプル素材）</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="site-section">
    <div class="site-container-wide">
      <SectionHeading title="選べる4つのレッスン" description="楽器ごとの個性を大切にしながら、基礎から表現まで段階的に学びます。" />
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {siteContent.courses.map((course) => (
          <article class="content-card content-card--interactive flex flex-col">
            <img src={course.photo} alt={`${course.name}を演奏するイメージ`} width="1000" height="750" class="aspect-[4/3] w-full object-cover" loading="lazy" decoding="async" />
            <div class="flex flex-1 flex-col p-6">
              <p class="eyebrow mb-2">{course.ages}</p>
              <h2 class="mb-3 text-2xl font-bold text-ink">{course.name}</h2>
              <p class="mb-6 flex-1 text-sm leading-7 text-ink-secondary">{course.summary}</p>
              <ActionLink href={`/lessons#${course.id}`} variant="tertiary" size="sm">詳しく見る</ActionLink>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="site-section site-section--subtle">
    <div class="site-container">
      <SectionHeading title="目標に合わせた学び方" description="同じ楽器でも、始める理由や続け方は人それぞれ。レッスンの内容とペースを一緒に整えます。" />
      <div class="grid border-y border-line md:grid-cols-3 md:divide-x md:divide-line">
        {[
          ['初めての方', '楽譜や楽器の扱い方から、一つずつ確認して進めます。'],
          ['好きな曲を弾きたい方', '目標の曲に必要な技術を整理し、練習しやすい順に取り組みます。'],
          ['舞台を目指す方', '人前での演奏を見据え、音色や表現、曲全体の組み立てを深めます。'],
        ].map(([title, body]) => (
          <div class="py-7 md:px-8">
            <h3 class="mb-3 text-xl font-bold text-ink">{title}</h3>
            <p class="mb-0 text-base leading-8 text-ink-secondary">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="site-section">
    <div class="site-container grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <SectionHeading eyebrow="個別指導" title="話を聞くことから、レッスンを始めます" />
        <div class="measure space-y-5 text-base leading-8 text-ink-secondary">
          <p>弾きたい曲、音楽経験、練習できる時間を伺い、その人に合う進め方を考えます。</p>
          <p>体験レッスンは、講師との相性や教室の雰囲気を確認するための時間です。無理な入会案内を前提にせず、疑問を持ち帰らない説明を目指します。</p>
        </div>
        <div class="mt-7 flex flex-wrap gap-3">
          <ActionLink href="/about" variant="secondary">教室の考え方</ActionLink>
          <ActionLink href="/pricing" variant="tertiary">料金を確認する</ActionLink>
        </div>
      </div>
      <figure class="border-l-4 border-accent bg-subtle p-6 lg:p-8">
        <blockquote class="mb-4 font-serif text-2xl font-bold leading-relaxed text-brand">「音楽を、自分の言葉として表現できるように。」</blockquote>
        <figcaption class="text-sm leading-7 text-ink-muted">Harmony Music Schoolが大切にするレッスン方針</figcaption>
      </figure>
    </div>
  </section>

  <section class="site-section site-section--subtle">
    <div class="site-container-narrow">
      <SectionHeading title="体験前によくあるご質問" description="初めての方が気になりやすい内容をまとめました。" />
      <FaqList items={faqItems} />
      <div class="mt-8"><ActionLink href="/faq" variant="tertiary">すべての質問を見る</ActionLink></div>
    </div>
  </section>

  {isDemo && (
    <section class="border-t border-line bg-canvas py-8">
      <div class="site-container-narrow text-sm leading-7 text-ink-muted">講師、所在地、実績などの実在情報は、本番用データが設定されるまで表示していません。</div>
    </section>
  )}

  <CTASection
    title="まずは、実際のレッスンを体験してください"
    description={`体験時間は${siteContent.trialDuration}、料金は3,000円（税別）。ご希望を伺いながら、無理のない始め方をご案内します。`}
    secondaryHref="/contact"
    secondaryLabel="質問してから検討する"
    primaryTestId="cta-trial-btn"
  />
</BaseLayout>
