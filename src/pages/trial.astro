---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import FormField from '../components/ui/FormField.astro';
import StatusPanel from '../components/ui/StatusPanel.astro';
import Button from '../components/ui/Button.astro';
import TrialSteps from '../components/content/TrialSteps.astro';
import { siteContent } from '../data/site';
---

<BaseLayout title="体験レッスン" description="45〜60分、3,000円（税別）の個人音楽レッスンを体験できます。">
  <PageHeader variant="compact" title="体験レッスン" description="経験や目標を伺い、実際に音を出しながら、ご自分に合うレッスンか確かめていただけます。" />

  <section class="site-section">
    <div class="site-container grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <dl class="trial-summary">
          <div><dt>料金</dt><dd>税込 {Math.floor(siteContent.trialPriceExTax * 1.1).toLocaleString('ja-JP')}円<small>税別 {siteContent.trialPriceExTax.toLocaleString('ja-JP')}円</small></dd></div>
          <div><dt>所要時間</dt><dd>{siteContent.trialDuration}</dd></div>
          <div><dt>ご連絡の目安</dt><dd>{siteContent.responseTime}</dd></div>
        </dl>
        <SectionHeading title="体験までの流れ" description="フォーム送信後、日程を確認してから予約が確定します。" spacing="compact" />
        <TrialSteps density="detailed" />
        <div class="mt-8 border-t border-line pt-6 text-sm leading-7 text-ink-secondary">
          <h3 class="mb-2 text-base font-bold text-ink">当日の持ち物</h3>
          <p class="mb-0">お持ちの楽器や楽譜がある場合はご持参ください。初めての方に必要なものは、日程のご案内時にお知らせします。</p>
        </div>
      </div>

      <div class="lg:col-span-8">
        <div class="form-shell border border-line bg-surface p-5 sm:p-8">
          <h2 class="mb-2 text-2xl font-bold">体験レッスン申込フォーム</h2>
          <p class="mb-7 text-sm leading-7 text-ink-secondary"><span class="text-error">*</span> は必須項目です。フリガナと電話番号は任意です。</p>

          {!siteContent.formEndpoint && (
            <div class="mb-6" id="trial-demo-notice">
              <StatusPanel type="warning" title="デモのため送信されません">
                <p>送信先が未設定です。入力と検証は試せますが、申込完了にはなりません。</p>
              </StatusPanel>
            </div>
          )}

          <div class="mb-6 space-y-4" aria-live="polite">
            <StatusPanel id="trial-success" type="success" title="申込を受け付けました" hidden focusable><p>ご入力のメールアドレスへ、{siteContent.responseTime}を目安にご連絡します。</p></StatusPanel>
            <StatusPanel id="trial-submit-error" type="error" title="送信できませんでした" hidden focusable><p data-status-message>時間をおいて、もう一度お試しください。</p></StatusPanel>
          </div>

          <form id="trial-form" data-testid="trial-form" data-endpoint={siteContent.formEndpoint ?? ''} novalidate class="space-y-6">
            <div class="grid gap-6 sm:grid-cols-2">
              <FormField id="name" label="お名前" required><input id="name" name="name" type="text" autocomplete="name" maxlength="50" required class="form-input" data-testid="input-name" aria-describedby="name-error" /></FormField>
              <FormField id="kana" label="フリガナ" hint="任意。全角カタカナで入力してください。"><input id="kana" name="kana" type="text" autocomplete="off" maxlength="50" class="form-input" aria-describedby="kana-hint kana-error" /></FormField>
            </div>
            <div class="grid gap-6 sm:grid-cols-2">
              <FormField id="email" label="メールアドレス" required><input id="email" name="email" type="email" autocomplete="email" required class="form-input" data-testid="input-email" aria-describedby="email-error" /></FormField>
              <FormField id="phone" label="電話番号" hint="任意。連絡を電話で希望する場合に入力してください。"><input id="phone" name="phone" type="tel" autocomplete="tel" class="form-input" data-testid="input-phone" aria-describedby="phone-hint phone-error" /></FormField>
            </div>
            <div class="grid gap-6 sm:grid-cols-2">
              <FormField id="instrument" label="ご希望の楽器" required>
                <select id="instrument" name="instrument" required class="form-input" data-testid="select-instrument" aria-describedby="instrument-error">
                  <option value="">選択してください</option>
                  {siteContent.courses.map((course) => <option value={course.id}>{course.name}</option>)}
                </select>
              </FormField>
              <FormField id="level" label="ご経験"><select id="level" name="level" class="form-input"><option value="">選択してください（任意）</option><option value="beginner">初めて</option><option value="experienced">経験あり</option><option value="advanced">本格的に学びたい</option></select></FormField>
            </div>
            <FormField id="preferred_date" label="希望日" hint="任意。予約は担当者との確認後に確定します。"><input id="preferred_date" name="preferred_date" type="date" class="form-input" aria-describedby="preferred_date-hint preferred_date-error" /></FormField>
            <FormField id="message" label="目標・ご質問" hint="弾いてみたい曲、経験、ご希望の曜日などをご記入ください。"><textarea id="message" name="message" maxlength="1000" class="form-input" aria-describedby="message-hint message-error"></textarea></FormField>
            <div class="form-field">
              <label class="flex min-h-12 cursor-pointer items-start gap-3 text-sm leading-7"><input id="privacy" name="privacy" type="checkbox" required class="mt-1.5 h-5 w-5 flex-none accent-brand" aria-describedby="privacy-error" /><span><a href="/privacy" class="text-link">プライバシーポリシー</a>を確認し、個人情報の取扱いに同意します <span class="text-error">*</span></span></label>
              <p id="privacy-error" class="form-error" data-error="privacy" hidden></p>
            </div>
            <Button type="submit" size="lg" testId="trial-submit-btn" class="w-full sm:w-auto"><span data-button-label>内容を確認して申し込む</span></Button>
            <p class="mb-0 text-xs leading-6 text-ink-muted">このボタンを押した時点では、日程は確定しません。</p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <style>
    .trial-summary { display: grid; margin: 0 0 var(--space-xl); border-top: var(--rule-hair) solid var(--color-rule-2); }
    .trial-summary > div { display: grid; grid-template-columns: minmax(7rem, .8fr) minmax(0, 1.2fr); gap: var(--space-sm); padding-block: var(--space-sm); border-bottom: var(--rule-hair) solid var(--color-rule); }
    .trial-summary dt { color: var(--color-muted); font-size: var(--text-sm); font-weight: 700; }
    .trial-summary dd { margin: 0; color: var(--color-brand); font-variant-numeric: tabular-nums; font-weight: 700; }
    .trial-summary small { display: block; margin-block-start: var(--space-3xs); color: var(--color-muted); font-weight: 400; }
    @media (max-width: 39.99rem) { .form-shell { border: 0; background: transparent; } }
  </style>
</BaseLayout>

<script>
  import { validateTrialForm } from '../lib/formValidation';

  const form = document.querySelector<HTMLFormElement>('#trial-form');
  const allowedInstruments = ['piano', 'guitar', 'violin', 'vocal'];

  if (form) {
    const instrument = form.elements.namedItem('instrument') as HTMLSelectElement;
    const queryInstrument = new URLSearchParams(window.location.search).get('instrument');
    if (queryInstrument && allowedInstruments.includes(queryInstrument)) instrument.value = queryInstrument;

    const dateInput = form.elements.namedItem('preferred_date') as HTMLInputElement;
    dateInput.min = new Date().toISOString().slice(0, 10);

    let submitting = false;
    const clearErrors = () => {
      form.querySelectorAll<HTMLElement>('[data-error]').forEach((node) => { node.hidden = true; node.textContent = ''; });
      form.querySelectorAll<HTMLElement>('[aria-invalid="true"]').forEach((node) => node.removeAttribute('aria-invalid'));
    };
    const showPanel = (id: string, show: boolean) => { const panel = document.querySelector<HTMLElement>(id); if (panel) panel.hidden = !show; return panel; };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submitting) return;
      clearErrors();
      showPanel('#trial-success', false);
      showPanel('#trial-submit-error', false);

      const data = new FormData(form);
      const result = validateTrialForm({
        name: String(data.get('name') ?? ''), kana: String(data.get('kana') ?? ''), email: String(data.get('email') ?? ''),
        phone: String(data.get('phone') ?? ''), instrument: String(data.get('instrument') ?? ''), privacyAgreed: data.get('privacy') === 'on',
      });

      if (!result.valid) {
        Object.entries(result.errors).forEach(([key, message]) => {
          const error = form.querySelector<HTMLElement>(`[data-error="${key}"]`);
          const fieldName = key === 'privacy' ? 'privacy' : key;
          const field = form.elements.namedItem(fieldName) as HTMLElement | null;
          if (error) { error.textContent = message; error.hidden = false; }
          field?.setAttribute('aria-invalid', 'true');
        });
        const first = form.querySelector<HTMLElement>('[aria-invalid="true"]');
        first?.focus();
        return;
      }

      const endpoint = form.dataset.endpoint;
      if (!endpoint) {
        document.querySelector<HTMLElement>('#trial-demo-notice')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }

      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const label = submit?.querySelector<HTMLElement>('[data-button-label]');
      submitting = true;
      if (submit) { submit.disabled = true; submit.setAttribute('aria-busy', 'true'); }
      if (label) label.textContent = '送信中…';
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 12000);

      try {
        const payload = Object.fromEntries(data.entries());
        const response = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ type: 'trial', ...payload }), signal: controller.signal });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        form.reset();
        const success = showPanel('#trial-success', true);
        success?.focus();
      } catch (error) {
        const panel = showPanel('#trial-submit-error', true);
        const message = panel?.querySelector<HTMLElement>('[data-status-message]');
        if (message) message.textContent = error instanceof DOMException && error.name === 'AbortError' ? '通信がタイムアウトしました。時間をおいて、もう一度お試しください。' : '通信エラーが発生しました。時間をおいて、もう一度お試しください。';
        panel?.focus();
      } finally {
        window.clearTimeout(timeout);
        submitting = false;
        if (submit) { submit.disabled = false; submit.removeAttribute('aria-busy'); }
        if (label) label.textContent = '内容を確認して申し込む';
      }
    });
  }
</script>
