---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import FormField from '../components/ui/FormField.astro';
import StatusPanel from '../components/ui/StatusPanel.astro';
import Button from '../components/ui/Button.astro';
import ActionLink from '../components/ui/ActionLink.astro';
import { siteContent } from '../data/site';
---

<BaseLayout title="お問い合わせ" description="レッスン、料金、通い方に関する一般的なお問い合わせはこちらから。">
  <PageHeader variant="compact" title="お問い合わせ" eyebrow="一般的なご相談" description="レッスン内容、料金、通い方についてのご質問を受け付けています。" />

  <section class="site-section">
    <div class="site-container grid gap-12 lg:grid-cols-12 lg:gap-16">
      <aside class="lg:col-span-4">
        <SectionHeading title="体験をご希望ですか？" description="楽器、経験、希望日をまとめて送れる専用フォームがあります。" spacing="compact" />
        <div class="mb-8 border-y border-line py-6">
          <h3 class="mb-2 text-lg font-bold">体験レッスンをご希望の方</h3>
          <p class="mb-5 text-sm leading-7 text-ink-secondary">楽器と経験を専用フォームからお知らせください。</p>
          <ActionLink href="/trial" size="sm">体験申込フォームへ</ActionLink>
        </div>
        <p class="mb-2 text-sm font-bold">返信の目安</p>
        <p class="mb-6 text-base text-ink-secondary">{siteContent.responseTime}</p>
        {siteContent.contact && (
          <address class="not-italic text-sm leading-8 text-ink-secondary"><p class="mb-1">{siteContent.contact.email}</p><p class="mb-0">{siteContent.contact.phone}</p></address>
        )}
      </aside>

      <div class="lg:col-span-8">
        <div class="border border-line bg-surface p-5 sm:p-8">
          <h2 class="mb-2 text-2xl font-bold">一般お問い合わせフォーム</h2>
          <p class="mb-7 text-sm leading-7 text-ink-secondary"><span class="text-error">*</span> は必須項目です。</p>

          {!siteContent.formEndpoint && <div id="contact-demo-notice" class="mb-6"><StatusPanel type="warning" title="デモのため送信されません"><p>送信先が未設定です。入力と検証は試せますが、お問い合わせ完了にはなりません。</p></StatusPanel></div>}
          <div class="mb-6 space-y-4" aria-live="polite">
            <StatusPanel id="contact-success" type="success" title="お問い合わせを受け付けました" hidden focusable><p>{siteContent.responseTime}を目安にご連絡します。</p></StatusPanel>
            <StatusPanel id="contact-submit-error" type="error" title="送信できませんでした" hidden focusable><p data-status-message>時間をおいて、もう一度お試しください。</p></StatusPanel>
          </div>

          <form id="contact-form" data-testid="contact-form" data-endpoint={siteContent.formEndpoint ?? ''} novalidate class="space-y-6">
            <div class="grid gap-6 sm:grid-cols-2">
              <FormField id="contact-name" label="お名前" required errorKey="name"><input id="contact-name" name="name" type="text" autocomplete="name" maxlength="50" required class="form-input" aria-describedby="contact-name-error" /></FormField>
              <FormField id="contact-email" label="メールアドレス" required errorKey="email"><input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required class="form-input" aria-describedby="contact-email-error" /></FormField>
            </div>
            <FormField id="contact-type" label="お問い合わせ種別" required errorKey="inquiry_type">
              <select id="contact-type" name="inquiry_type" required class="form-input" aria-describedby="contact-type-error">
                <option value="">選択してください</option>
                <option value="trial">体験レッスンについて</option>
                <option value="lesson">レッスン内容について</option>
                <option value="pricing">料金・スケジュールについて</option>
                <option value="other">その他</option>
              </select>
            </FormField>
            <FormField id="contact-message" label="お問い合わせ内容" required errorKey="message"><textarea id="contact-message" name="message" maxlength="2000" required class="form-input" aria-describedby="contact-message-error"></textarea></FormField>
            <div class="form-field">
              <label class="flex min-h-12 cursor-pointer items-start gap-3 text-sm leading-7"><input id="contact-privacy" name="privacy" type="checkbox" required class="mt-1.5 h-5 w-5 flex-none accent-brand" aria-describedby="contact-privacy-error" /><span><a href="/privacy" class="text-link">プライバシーポリシー</a>を確認し、個人情報の取扱いに同意します <span class="text-error">*</span></span></label>
              <p id="contact-privacy-error" class="form-error" data-error="privacy" hidden></p>
            </div>
            <Button type="submit" size="lg" testId="contact-submit-btn" class="w-full sm:w-auto"><span data-button-label>お問い合わせを送信する</span></Button>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  if (form) {
    let submitting = false;
    const showPanel = (id: string, show: boolean) => { const panel = document.querySelector<HTMLElement>(id); if (panel) panel.hidden = !show; return panel; };
    const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submitting) return;
      form.querySelectorAll<HTMLElement>('[data-error]').forEach((node) => { node.hidden = true; node.textContent = ''; });
      form.querySelectorAll<HTMLElement>('[aria-invalid="true"]').forEach((node) => node.removeAttribute('aria-invalid'));
      showPanel('#contact-success', false); showPanel('#contact-submit-error', false);
      const data = new FormData(form);
      const errors: Record<string, string> = {};
      const name = String(data.get('name') ?? '').trim();
      const email = String(data.get('email') ?? '').trim();
      const type = String(data.get('inquiry_type') ?? '');
      const message = String(data.get('message') ?? '').trim();
      if (!name) errors.name = 'お名前を入力してください';
      if (!email) errors.email = 'メールアドレスを入力してください'; else if (!emailPattern.test(email)) errors.email = '正しいメールアドレスを入力してください';
      if (!type) errors.inquiry_type = 'お問い合わせ種別を選択してください';
      if (!message) errors.message = 'お問い合わせ内容を入力してください';
      if (data.get('privacy') !== 'on') errors.privacy = 'プライバシーポリシーへの同意が必要です';

      if (Object.keys(errors).length > 0) {
        for (const [key, value] of Object.entries(errors)) {
          const error = form.querySelector<HTMLElement>(`[data-error="${key}"]`);
          const field = form.elements.namedItem(key === 'privacy' ? 'privacy' : key) as HTMLElement | null;
          if (error) { error.textContent = value; error.hidden = false; }
          field?.setAttribute('aria-invalid', 'true');
        }
        form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
        return;
      }

      const endpoint = form.dataset.endpoint;
      if (!endpoint) { document.querySelector<HTMLElement>('#contact-demo-notice')?.scrollIntoView({ behavior: 'smooth', block: 'center' }); return; }
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const label = submit?.querySelector<HTMLElement>('[data-button-label]');
      submitting = true;
      if (submit) { submit.disabled = true; submit.setAttribute('aria-busy', 'true'); }
      if (label) label.textContent = '送信中…';
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 12000);
      try {
        const response = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ type: 'contact', ...Object.fromEntries(data.entries()) }), signal: controller.signal });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        form.reset();
        showPanel('#contact-success', true)?.focus();
      } catch (error) {
        const panel = showPanel('#contact-submit-error', true);
        const messageNode = panel?.querySelector<HTMLElement>('[data-status-message]');
        if (messageNode) messageNode.textContent = error instanceof DOMException && error.name === 'AbortError' ? '通信がタイムアウトしました。時間をおいて、もう一度お試しください。' : '通信エラーが発生しました。時間をおいて、もう一度お試しください。';
        panel?.focus();
      } finally {
        window.clearTimeout(timeout); submitting = false;
        if (submit) { submit.disabled = false; submit.removeAttribute('aria-busy'); }
        if (label) label.textContent = 'お問い合わせを送信する';
      }
    });
  }
</script>
