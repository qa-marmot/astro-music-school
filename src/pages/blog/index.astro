---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import StatusPanel from '../../components/ui/StatusPanel.astro';
import { getBlogList, getCategories, formatBlogPost } from '../../lib/blog';

const LIMIT = 9;
const [postResponse, categories] = await Promise.all([getBlogList({ limit: LIMIT }), getCategories()]);
const posts = postResponse.contents.map(formatBlogPost);
---

<BaseLayout title="ブログ" description="音楽やレッスンに関するお知らせと読みものをお届けします。">
  <PageHeader title="ブログ" eyebrow="Harmony Journal" description="教室からのお知らせと、音楽を学ぶための読みもの。" />

  <section class="site-section">
    <div class="site-container">
      {categories.length > 0 && (
        <nav class="mb-10 flex flex-wrap gap-2" aria-label="ブログカテゴリ">
          <a href="/blog" aria-current="page" class="action action--primary action--sm">すべて</a>
          {categories.map((category) => <a href={`/blog/category/${category.id}`} class="action action--secondary action--sm">{category.name}</a>)}
        </nav>
      )}

      {posts.length > 0 ? (
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">{posts.map((post) => <BlogCard post={post} />)}</div>
      ) : (
        <div class="site-container-narrow px-0">
          <StatusPanel type="empty" title="記事はまだありません">
            <p>microCMSを設定して記事を公開すると、ここに一覧が表示されます。</p>
          </StatusPanel>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
