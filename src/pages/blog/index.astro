---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import { getBlogList, getCategories, formatBlogPost } from '../../lib/blog';

const LIMIT = 9;
const [postResponse, categories] = await Promise.all([getBlogList({ limit: LIMIT }), getCategories()]);
const posts = postResponse.contents.map(formatBlogPost);
---

<BaseLayout title="ブログ" description="音楽やレッスンに関するお知らせと読みものをお届けします。">
  <PageHeader variant="editorial" title="ブログ" eyebrow="Harmony Journal" description="日々の練習を少し続けやすくする、楽器と声の小さな読みもの。" />

  <section class="site-section">
    <div class="site-container">
      {categories.length > 0 && (
        <nav class="mb-10 flex flex-wrap gap-2" aria-label="ブログカテゴリ">
          <a href="/blog" aria-current="page" class="action action--primary action--sm">すべて</a>
          {categories.map((category) => <a href={`/blog/category/${category.id}`} class="action action--secondary action--sm">{category.name}</a>)}
        </nav>
      )}

      {posts.length > 0 && (
        <div>
          <BlogCard post={posts[0]} variant="featured" />
          <div class="mt-10 border-t border-line">{posts.slice(1).map((post) => <BlogCard post={post} variant="compact" />)}</div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
