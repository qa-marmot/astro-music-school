---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import BlogCard from '../../../components/blog/BlogCard.astro';
import StatusPanel from '../../../components/ui/StatusPanel.astro';
import ActionLink from '../../../components/ui/ActionLink.astro';
import { getBlogList, getCategories, formatBlogPost } from '../../../lib/blog';
import type { GetStaticPaths } from 'astro';
import type { BlogPost, Category } from '../../../types';

export const getStaticPaths: GetStaticPaths = async () => {
  const categories = await getCategories();
  return Promise.all(categories.map(async (category) => {
    const response = await getBlogList({ categoryId: category.id, limit: 30 });
    return { params: { id: category.id }, props: { category, posts: response.contents } };
  }));
};

const { category, posts: rawPosts } = Astro.props as { category: Category; posts: BlogPost[] };
const posts = rawPosts.map(formatBlogPost);
---

<BaseLayout title={`${category.name}の記事`} description={`${category.name}カテゴリの記事一覧です。`}>
  <Breadcrumbs items={[{ label: 'トップ', href: '/' }, { label: 'ブログ', href: '/blog' }, { label: category.name }]} />
  <PageHeader title={category.name} eyebrow="ブログカテゴリ" description={`${category.name}に関する記事をまとめています。`} />
  <section class="site-section">
    <div class="site-container">
      <div class="mb-9"><ActionLink href="/blog" variant="tertiary">すべての記事を見る</ActionLink></div>
      {posts.length > 0 ? <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">{posts.map((post) => <BlogCard post={post} />)}</div> : <StatusPanel type="empty" title="このカテゴリの記事はまだありません"><p>新しい記事が公開されるまでお待ちください。</p></StatusPanel>}
    </div>
  </section>
</BaseLayout>
