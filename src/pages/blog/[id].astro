---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import ActionLink from '../../components/ui/ActionLink.astro';
import { getAllBlogPosts, formatBlogPost } from '../../lib/blog';
import { sanitizeHtml } from '../../lib/sanitize';
import { isDemo } from '../../data/site';
import type { GetStaticPaths } from 'astro';
import type { BlogPost } from '../../types';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getAllBlogPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
};

const { post: rawPost } = Astro.props as { post: BlogPost };
const post = formatBlogPost(rawPost);
const jsonLd = !isDemo ? {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.title,
  datePublished: post.publishedAt, dateModified: post.revisedAt, description: post.excerpt,
  ...(post.eyecatchUrl ? { image: post.eyecatchUrl } : {}),
} : undefined;
---

<BaseLayout title={post.title} description={post.excerpt} ogType="article" ogImage={post.eyecatchUrl} jsonLd={jsonLd}>
  <Breadcrumbs items={[{ label: 'トップ', href: '/' }, { label: 'ブログ', href: '/blog' }, { label: post.title }]} />
  <article class="site-section">
    <div class="site-container-narrow">
      <header class="mb-10 border-b border-line pb-8">
        <div class="mb-4 flex flex-wrap items-center gap-3 text-sm">
          <a href={`/blog/category/${post.category.id}`} class="border-l-2 border-accent pl-2 font-bold text-brand underline-offset-4 hover:underline">{post.category.name}</a>
          <time class="text-ink-muted" datetime={post.publishedAt}>{post.formattedDate}</time>
        </div>
        <h1 class="page-title mb-5">{post.title}</h1>
        <p class="lead mb-0 text-ink-secondary">{post.excerpt}</p>
      </header>

      {post.eyecatchUrl && (
        <img src={post.eyecatchUrl} alt={post.eyecatchAlt ?? ''} width={post.eyecatch?.width ?? 1200} height={post.eyecatch?.height ?? 675} class="mb-12 aspect-video w-full object-cover" fetchpriority="high" decoding="async" />
      )}
      <div class="prose-content" set:html={sanitizeHtml(post.content)} />
      <footer class="mt-14 border-t border-line pt-8"><ActionLink href="/blog" variant="tertiary">ブログ一覧へ戻る</ActionLink></footer>
    </div>
  </article>
</BaseLayout>
