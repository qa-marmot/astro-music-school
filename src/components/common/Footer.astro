---
import ActionLink from '../ui/ActionLink.astro';
import { isDemo, siteContent } from '../../data/site';
const year = new Date().getFullYear();
---

<footer class="border-t border-brand-hover bg-[#112418] text-canvas">
  <div class="site-container-wide py-14 lg:py-16">
    <div class={`grid gap-12 border-b border-canvas/20 pb-12 ${siteContent.contact ? 'lg:grid-cols-[1.2fr_1fr_1fr]' : 'lg:grid-cols-[1.25fr_1fr]'}`}>
      <div>
        <p class="mb-3 font-serif text-2xl font-bold">{siteContent.name}</p>
        <p class="mb-6 max-w-sm text-sm leading-7 text-canvas/75">
          ピアノ・ギター・バイオリン・声楽を、一人ひとりの目標に合わせて学ぶ個人音楽レッスン。
        </p>
        <ActionLink href="/trial" size="sm" theme="dark">体験レッスン</ActionLink>
      </div>

      <nav aria-label="フッターナビゲーション">
        <p class="mb-4 text-sm font-bold text-accent">ご案内</p>
        <ul class="grid grid-cols-2 gap-x-6 gap-y-3 text-sm text-canvas/75">
          <li><a href="/lessons" class="hover:text-accent">レッスン</a></li>
          <li><a href="/pricing" class="hover:text-accent">料金</a></li>
          <li><a href="/about" class="hover:text-accent">教室紹介</a></li>
          <li><a href="/access" class="hover:text-accent">アクセス</a></li>
          <li><a href="/faq" class="hover:text-accent">FAQ</a></li>
          <li><a href="/blog" class="hover:text-accent">ブログ</a></li>
          <li><a href="/contact" class="hover:text-accent">お問い合わせ</a></li>
          <li><a href="/privacy" class="hover:text-accent">プライバシー</a></li>
        </ul>
      </nav>

      {siteContent.contact && <div>
        <p class="mb-4 text-sm font-bold text-accent">教室情報</p>
        <address class="not-italic text-sm leading-7 text-canvas/75">
          〒{siteContent.contact.postalCode}<br />{siteContent.contact.address}<br />
          <a href={`tel:${siteContent.contact.phone}`} class="hover:text-accent">{siteContent.contact.phone}</a><br />
          <a href={`mailto:${siteContent.contact.email}`} class="hover:text-accent">{siteContent.contact.email}</a>
        </address>
      </div>}
    </div>

    <div class="flex flex-col gap-3 pt-7 text-xs text-canvas/55 sm:flex-row sm:items-center sm:justify-between">
      <p class="mb-0">&copy; {year} {siteContent.name}. All rights reserved.</p>
      {isDemo && <p class="mb-0 max-w-xl sm:text-right">デモサイトです。掲載写真・料金・文章は構成確認用で、実在の教室情報ではありません。検索エンジンには公開されません。</p>}
    </div>
  </div>
</footer>
