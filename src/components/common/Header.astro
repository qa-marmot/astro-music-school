---
import ActionLink from '../ui/ActionLink.astro';

const navItems = [
  { label: 'レッスン', href: '/lessons' },
  { label: '料金', href: '/pricing' },
  { label: '教室紹介', href: '/about' },
  { label: 'アクセス', href: '/access' },
  { label: 'FAQ', href: '/faq' },
  { label: 'ブログ', href: '/blog' },
];

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header" id="site-header">
  <div class="site-container-wide site-header__bar">
    <a href="/" class="site-wordmark brand-wordmark" aria-label="トップページへ">
      <span>Harmony</span>
      <small>Music School</small>
    </a>

    <nav class="site-header__primary" aria-label="主要ナビゲーション">
      {navItems.slice(0, 2).map((item) => (
        <a
          href={item.href}
          class={isCurrent(item.href) ? 'is-current' : ''}
          aria-current={isCurrent(item.href) ? 'page' : undefined}
        >{item.label}</a>
      ))}
    </nav>

    <div class="site-header__actions">
      <button
        id="mobile-menu-btn"
        type="button"
        class="site-header__menu-button"
        aria-label="メニューを開く"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="menu-icon" aria-hidden="true">メニュー</span>
        <span class="close-icon hidden" aria-hidden="true">閉じる</span>
      </button>
      <ActionLink href="/trial" size="sm" class="site-header__trial">体験レッスン</ActionLink>
    </div>
  </div>

  <div id="mobile-menu" class="site-menu hidden">
    <div class="site-container-wide site-menu__inner">
      <nav class="site-menu__links" aria-label="メインナビゲーション">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={isCurrent(item.href) ? 'is-current' : ''}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >{item.label}</a>
        ))}
        <a href="/contact" class={isCurrent('/contact') ? 'is-current' : ''} aria-current={isCurrent('/contact') ? 'page' : undefined}>お問い合わせ</a>
        <a href="/privacy" class={isCurrent('/privacy') ? 'is-current' : ''} aria-current={isCurrent('/privacy') ? 'page' : undefined}>プライバシー</a>
      </nav>
      <div class="site-menu__note">
        <p>ピアノ・ギター・バイオリン・声楽</p>
        <p>一人ひとりに合わせた個人レッスン</p>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header { position: sticky; z-index: var(--z-sticky-nav); top: 0; border-bottom: var(--rule-hair) solid var(--color-rule); color: var(--color-ink); background: var(--color-paper); }
  .site-header__bar { display: grid; min-height: var(--header-height); grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: var(--space-sm); }
  .site-wordmark { display: inline-flex; width: fit-content; min-height: 44px; flex-direction: column; justify-content: center; color: var(--color-brand); font-size: 1.25rem; font-weight: 500; letter-spacing: -.02em; line-height: .95; text-decoration: none; white-space: nowrap; }
  .site-wordmark small { margin-block-start: .3rem; color: var(--color-muted); font-family: var(--font-body); font-size: .5625rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .site-header__primary { display: none; align-items: stretch; justify-content: center; gap: var(--space-lg); }
  .site-header__primary a { display: inline-flex; min-height: 44px; align-items: center; border-bottom: var(--rule-fine) solid transparent; color: var(--color-ink-2); font-size: var(--text-sm); font-weight: 700; white-space: nowrap; text-decoration: none; }
  .site-header__primary a.is-current { border-bottom-color: var(--color-accent); color: var(--color-brand); }
  .site-header__actions { display: flex; align-items: center; justify-content: flex-end; gap: var(--space-2xs); }
  .site-header__menu-button { min-width: 4.25rem; min-height: 44px; padding-inline: var(--space-xs); border: 0; color: var(--color-brand); background: transparent; font-size: var(--text-xs); font-weight: 700; letter-spacing: .03em; white-space: nowrap; }
  .site-menu { position: absolute; inset-inline: 0; top: 100%; border-bottom: var(--rule-hair) solid var(--color-rule-2); background: var(--color-surface); box-shadow: var(--shadow-overlay); }
  .site-menu__inner { display: grid; gap: var(--space-lg); padding-block: var(--space-md) var(--space-lg); }
  .site-menu__links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: var(--rule-hair) solid var(--color-rule); }
  .site-menu__links a { display: flex; min-height: 52px; align-items: center; border-bottom: var(--rule-hair) solid var(--color-rule); color: var(--color-ink-2); font-weight: 700; white-space: nowrap; text-decoration: none; }
  .site-menu__links a.is-current { color: var(--color-brand); }
  .site-menu__note { display: grid; align-content: end; color: var(--color-muted); font-size: var(--text-sm); line-height: 1.7; }
  .site-menu__note p { margin: 0; }
  @media (max-width: 24rem) { .site-header__bar { gap: var(--space-2xs); } .site-wordmark { font-size: 1.0625rem; } .site-header__menu-button { min-width: 3.5rem; padding-inline: var(--space-2xs); } }
  @media (min-width: 60rem) {
    .site-header__bar { grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); }
    .site-header__primary { display: flex; }
    .site-menu__inner { grid-template-columns: minmax(0, 2fr) minmax(16rem, 1fr); }
    .site-menu__links { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (hover: hover) and (pointer: fine) {
    .site-header__primary a:hover, .site-menu__links a:hover, .site-header__menu-button:hover { color: var(--color-brand-dark); }
  }
</style>

<script>
  const button = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const openIcon = button?.querySelector('.menu-icon');
  const closeIcon = button?.querySelector('.close-icon');

  const setMenu = (open: boolean) => {
    if (!button || !menu) return;
    menu.classList.toggle('hidden', !open);
    openIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
  };

  button?.addEventListener('click', () => setMenu(button.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      button.focus();
    }
  });
  document.addEventListener('click', (event) => {
    const header = document.getElementById('site-header');
    if (header && !header.contains(event.target as Node)) setMenu(false);
  });
</script>
