---
import ActionLink from '../ui/ActionLink.astro';

const navItems = [
  { label: 'レッスン', href: '/lessons' },
  { label: '料金', href: '/pricing' },
  { label: '教室紹介', href: '/about' },
  { label: 'アクセス', href: '/access' },
  { label: 'FAQ', href: '/faq' },
  { label: 'ブログ', href: '/blog' },
];

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-line bg-canvas" id="site-header">
  <div class="site-container-wide flex h-16 items-center justify-between lg:h-[72px]">
    <a href="/" class="flex min-h-11 items-center no-underline" aria-label="トップページへ">
      <span class="border-l-2 border-accent pl-3 leading-tight">
        <span class="block font-serif text-xl font-bold tracking-[-.02em] text-brand">Harmony</span>
        <span class="block text-[9px] font-bold tracking-[.18em] text-ink-muted">MUSIC SCHOOL</span>
      </span>
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="メインナビゲーション">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`flex min-h-11 items-center border-b-2 text-sm font-bold no-underline transition-colors duration-base ${isCurrent(item.href) ? 'border-accent text-brand' : 'border-transparent text-ink-secondary hover:border-line-strong hover:text-brand'}`}
          aria-current={isCurrent(item.href) ? 'page' : undefined}
        >{item.label}</a>
      ))}
    </nav>

    <div class="hidden lg:block">
      <ActionLink href="/trial" size="sm">体験レッスン</ActionLink>
    </div>

    <button
      id="mobile-menu-btn"
      type="button"
      class="flex h-11 w-11 items-center justify-center text-brand lg:hidden"
      aria-label="メニューを開く"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="menu-icon h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" stroke-width="2" stroke-linecap="round" /></svg>
      <svg class="close-icon hidden h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke-width="2" stroke-linecap="round" /></svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-line bg-surface shadow-overlay lg:hidden">
    <nav class="site-container-wide grid gap-1 py-4" aria-label="モバイルナビゲーション">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`flex min-h-12 items-center border-l-2 px-4 text-base font-bold no-underline ${isCurrent(item.href) ? 'border-accent bg-subtle text-brand' : 'border-transparent text-ink-secondary hover:bg-subtle hover:text-brand'}`}
          aria-current={isCurrent(item.href) ? 'page' : undefined}
        >{item.label}</a>
      ))}
      <div class="mt-3 grid gap-2 border-t border-line pt-4 sm:grid-cols-2">
        <ActionLink href="/trial">体験レッスン</ActionLink>
        <ActionLink href="/contact" variant="secondary">お問い合わせ</ActionLink>
      </div>
    </nav>
  </div>
</header>

<script>
  const button = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const openIcon = button?.querySelector('.menu-icon');
  const closeIcon = button?.querySelector('.close-icon');

  const setMenu = (open: boolean) => {
    if (!button || !menu) return;
    menu.classList.toggle('hidden', !open);
    openIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
  };

  button?.addEventListener('click', () => setMenu(button.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      button.focus();
    }
  });
  document.addEventListener('click', (event) => {
    const header = document.getElementById('site-header');
    if (header && !header.contains(event.target as Node)) setMenu(false);
  });
</script>
