---
import ActionLink from '../ui/ActionLink.astro';

const navItems = [
  { label: 'レッスン', href: '/lessons' },
  { label: '料金', href: '/pricing' },
  { label: '教室紹介', href: '/about' },
  { label: 'アクセス', href: '/access' },
  { label: 'FAQ', href: '/faq' },
  { label: 'ブログ', href: '/blog' },
];

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-mast" id="site-header">
  <div class="site-container-wide">
    <p class="site-mast__context hidden lg:block">ピアノ・ギター・バイオリン・声楽の個人レッスン</p>

    <div class="site-mast__brand-row">
      <a href="/" class="site-wordmark" aria-label="トップページへ">
        <span class="site-wordmark__main">Harmony</span>
        <span class="site-wordmark__sub">Music School</span>
      </a>

      <button
        id="mobile-menu-btn"
        type="button"
        class="site-mast__menu-button lg:hidden"
        aria-label="メニューを開く"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="menu-icon" aria-hidden="true">メニュー</span>
        <span class="close-icon hidden" aria-hidden="true">閉じる</span>
      </button>
    </div>

    <nav class="site-mast__nav hidden lg:flex" aria-label="メインナビゲーション">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={isCurrent(item.href) ? 'is-current' : ''}
          aria-current={isCurrent(item.href) ? 'page' : undefined}
        >{item.label}</a>
      ))}
      <ActionLink href="/trial" size="sm">体験レッスン</ActionLink>
    </nav>
    <div class="site-mast__double-rule" aria-hidden="true"></div>
  </div>

  <div id="mobile-menu" class="site-mast__mobile hidden lg:hidden">
    <nav class="site-container-wide grid" aria-label="モバイルナビゲーション">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={isCurrent(item.href) ? 'is-current' : ''}
          aria-current={isCurrent(item.href) ? 'page' : undefined}
        >{item.label}</a>
      ))}
      <div class="site-mast__mobile-actions">
        <ActionLink href="/trial">体験レッスン</ActionLink>
        <ActionLink href="/contact" variant="secondary">お問い合わせ</ActionLink>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-mast { position: relative; z-index: var(--z-sticky); color: var(--color-ink); background: var(--color-paper); }
  .site-mast__context { margin: 0; padding-block: var(--space-xs) var(--space-2xs); text-align: center; color: var(--color-muted); font-size: var(--text-xs); letter-spacing: .08em; }
  .site-mast__brand-row { display: flex; min-height: 4rem; align-items: center; justify-content: space-between; }
  .site-wordmark { display: inline-flex; min-height: 44px; flex-direction: column; justify-content: center; color: var(--color-brand); line-height: .95; text-decoration: none; }
  .site-wordmark__main { font-family: var(--font-display); font-size: clamp(1.5rem, 4vw, 3rem); font-weight: 700; letter-spacing: -.035em; }
  .site-wordmark__sub { margin-block-start: .25rem; color: var(--color-muted); font-size: .625rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .site-mast__menu-button { min-width: 4.5rem; min-height: 44px; border: 0; color: var(--color-brand); background: transparent; font-size: var(--text-xs); font-weight: 700; letter-spacing: .05em; }
  .site-mast__nav { min-height: 3.25rem; align-items: center; justify-content: center; gap: clamp(1rem, 2.5vw, 2rem); border-top: var(--rule-hair) solid var(--color-rule); }
  .site-mast__nav > a:not(.action) { display: inline-flex; min-height: 44px; align-items: center; border-bottom: var(--rule-fine) solid transparent; color: var(--color-ink-2); font-size: var(--text-sm); font-weight: 700; white-space: nowrap; text-decoration: none; }
  .site-mast__nav > a.is-current { border-bottom-color: var(--color-accent); color: var(--color-brand); }
  .site-mast__nav .action { margin-inline-start: var(--space-sm); }
  .site-mast__double-rule { height: 5px; border-block: var(--rule-hair) solid var(--color-rule-2); }
  .site-mast__mobile { position: absolute; inset-inline: 0; top: 100%; border-bottom: var(--rule-hair) solid var(--color-rule-2); background: var(--color-surface); box-shadow: var(--shadow-overlay); }
  .site-mast__mobile nav { padding-block: var(--space-sm) var(--space-md); }
  .site-mast__mobile nav > a { display: flex; min-height: 48px; align-items: center; border-bottom: var(--rule-hair) solid var(--color-rule); color: var(--color-ink-2); font-weight: 700; white-space: nowrap; text-decoration: none; }
  .site-mast__mobile nav > a.is-current { color: var(--color-brand); }
  .site-mast__nav > a:not(.action):active, .site-mast__mobile nav > a:active { color: var(--color-brand-dark); }
  .site-mast__mobile-actions { display: grid; gap: var(--space-xs); padding-block-start: var(--space-md); }
  @media (min-width: 40rem) { .site-mast__mobile-actions { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) {
    .site-mast__brand-row { justify-content: center; padding-block: var(--space-xs) var(--space-md); }
    .site-wordmark { align-items: center; text-align: center; }
  }
  @media (max-width: 63.999rem) { .site-mast { position: sticky; top: 0; } }
  @media (hover: hover) and (pointer: fine) {
    .site-mast__nav > a:not(.action):hover, .site-mast__mobile nav > a:hover { color: var(--color-brand); }
  }
</style>

<script>
  const button = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const openIcon = button?.querySelector('.menu-icon');
  const closeIcon = button?.querySelector('.close-icon');

  const setMenu = (open: boolean) => {
    if (!button || !menu) return;
    menu.classList.toggle('hidden', !open);
    openIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
  };

  button?.addEventListener('click', () => setMenu(button.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      button.focus();
    }
  });
  document.addEventListener('click', (event) => {
    const header = document.getElementById('site-header');
    if (header && !header.contains(event.target as Node)) setMenu(false);
  });
</script>
