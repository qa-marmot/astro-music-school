---
interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  variant?: 'standard' | 'compact' | 'editorial';
}
const { title, description, eyebrow, variant = 'standard' } = Astro.props;
---

<header class={`page-intro page-intro--${variant}`}>
  <div class="site-container page-intro__inner">
    <div class="page-intro__heading">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class="page-title">{title}</h1>
    </div>
    {description && <p class="page-intro__description">{description}</p>}
  </div>
</header>

<style>
  .page-intro { border-bottom: var(--rule-hair) solid var(--color-rule); background: var(--color-paper); }
  .page-intro__inner { display: grid; gap: var(--space-lg); padding-block: clamp(2.5rem, 6vw, 4.5rem); }
  .page-intro__heading, .page-intro__description { min-width: 0; }
  .page-intro h1 { margin: 0; color: var(--color-ink); }
  .page-intro__description { max-width: 42em; margin: 0; color: var(--color-ink-2); font-size: clamp(1rem, 2vw, 1.1875rem); line-height: 1.8; }
  .page-intro--compact .page-intro__inner { padding-block: var(--space-lg); }
  .page-intro--compact h1 { font-size: clamp(1.875rem, 4vw, 2.75rem); }
  .page-intro--editorial .page-intro__inner { padding-block: var(--space-2xl) var(--space-section); }
  .page-intro--editorial h1 { max-width: 14ch; font-size: var(--text-display-s); }
  @media (min-width: 60rem) {
    .page-intro:not(.page-intro--compact) .page-intro__inner { grid-template-columns: minmax(0, 7fr) minmax(18rem, 4fr); align-items: end; }
    .page-intro:not(.page-intro--compact) .page-intro__description { justify-self: end; }
  }
</style>
