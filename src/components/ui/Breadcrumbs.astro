---
interface Item { label: string; href?: string; }
interface Props { items: Item[]; }
const { items } = Astro.props;
---

<nav aria-label="パンくず" class="border-b border-line bg-subtle">
  <ol class="site-container-narrow flex flex-wrap items-center gap-2 py-3 text-sm text-ink-muted">
    {items.map((item, index) => (
      <li class="flex items-center gap-2">
        {index > 0 && <span aria-hidden="true">/</span>}
        {item.href ? (
          <a href={item.href} class="underline underline-offset-4 hover:text-brand">{item.label}</a>
        ) : (
          <span aria-current="page" class="text-ink">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
