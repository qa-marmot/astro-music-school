---
interface Item { label: string; href?: string; }
interface Props { items: Item[]; }
const { items } = Astro.props;
---

<nav aria-label="パンくず" class="breadcrumbs">
  <ol class="site-container-narrow breadcrumbs__list">
    {items.map((item, index) => (
      <li>
        {index > 0 && <span aria-hidden="true">→</span>}
        {item.href ? (
          <a href={item.href}>{item.label}</a>
        ) : (
          <span aria-current="page">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs { border-bottom: var(--rule-hair) solid var(--color-rule); background: var(--color-paper-2); }
  .breadcrumbs__list { display: flex; min-width: 0; align-items: center; gap: var(--space-xs); margin-block: 0; padding-block: var(--space-xs); overflow: hidden; color: var(--color-muted); font-size: var(--text-sm); list-style: none; }
  .breadcrumbs__list li { display: flex; min-width: 0; align-items: center; gap: var(--space-xs); white-space: nowrap; }
  .breadcrumbs__list li:last-child { overflow: hidden; }
  .breadcrumbs__list li:last-child span { overflow: hidden; color: var(--color-ink); text-overflow: ellipsis; }
  .breadcrumbs__list a { display: inline-flex; min-height: 44px; align-items: center; color: var(--color-brand); text-decoration: underline; text-underline-offset: .25em; }
</style>
