---
interface Props {
  type?: 'button' | 'submit' | 'reset';
  variant?: 'primary' | 'secondary' | 'tertiary';
  size?: 'sm' | 'md' | 'lg';
  loading?: boolean;
  disabled?: boolean;
  testId?: string;
  class?: string;
}

const {
  type = 'button', variant = 'primary', size = 'md', loading = false,
  disabled = false, testId, class: className = '',
} = Astro.props;
---

<button
  type={type}
  class={`action action--${variant} action--${size} ${className}`}
  disabled={disabled || loading}
  aria-busy={loading ? 'true' : undefined}
  data-testid={testId}
>
  <slot />
</button>
