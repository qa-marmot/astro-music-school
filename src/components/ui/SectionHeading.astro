---
interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  align?: 'left' | 'center';
  inverse?: boolean;
}
const { title, description, eyebrow, align = 'left', inverse = false } = Astro.props;
---

<div class={`${align === 'center' ? 'mx-auto text-center' : ''} mb-10 max-w-2xl lg:mb-14`}>
  {eyebrow && <p class={`eyebrow ${inverse ? '!text-accent' : ''}`}>{eyebrow}</p>}
  <h2 class={`section-title mb-4 ${inverse ? 'text-canvas' : 'text-ink'}`}>{title}</h2>
  {description && <p class={`mb-0 text-base leading-8 ${inverse ? 'text-canvas/80' : 'text-ink-secondary'}`}>{description}</p>}
</div>
