---
interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  align?: 'left' | 'center';
  inverse?: boolean;
  spacing?: 'compact' | 'default';
}
const { title, description, eyebrow, align = 'left', inverse = false, spacing = 'default' } = Astro.props;
---

<div class={`section-heading section-heading--${align} section-heading--${spacing}`}>
  {eyebrow && <p class={`eyebrow ${inverse ? '!text-accent' : ''}`}>{eyebrow}</p>}
  <h2 class={`section-title ${inverse ? 'section-title--inverse' : ''}`}>{title}</h2>
  {description && <p class={inverse ? 'section-heading__description section-heading__description--inverse' : 'section-heading__description'}>{description}</p>}
</div>

<style>
  .section-heading { max-width: 42em; margin-block-end: var(--space-xl); }
  .section-heading--compact { margin-block-end: var(--space-lg); }
  .section-heading--center { margin-inline: auto; text-align: center; }
  .section-heading h2 { margin-block-end: var(--space-sm); }
  .section-heading p:last-child { margin: 0; }
  .section-title--inverse { color: var(--color-paper); }
  .section-heading__description { color: var(--color-ink-2); font-size: 1rem; line-height: 1.8; }
  .section-heading__description--inverse { color: var(--color-on-dark-rule); }
  @media (min-width: 60rem) { .section-heading:not(.section-heading--compact) { margin-block-end: var(--space-2xl); } }
</style>
