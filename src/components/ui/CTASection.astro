---
import ActionLink from './ActionLink.astro';

interface Props {
  title: string;
  description: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  primaryTestId?: string;
}

const {
  title, description,
  primaryHref = '/trial',
  primaryLabel = '体験レッスン（3,000円）を申し込む',
  secondaryHref,
  secondaryLabel,
  primaryTestId,
} = Astro.props;
---

<section class="site-section site-section--dark">
  <div class="site-container-narrow text-center">
    <p class="eyebrow !text-canvas">次の一歩</p>
    <h2 class="section-title mb-4 text-canvas">{title}</h2>
    <p class="mx-auto mb-8 max-w-xl text-base leading-8 text-canvas/80">{description}</p>
    <div class="flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
      <ActionLink href={primaryHref} size="lg" theme="dark" testId={primaryTestId}>{primaryLabel}</ActionLink>
      {secondaryHref && secondaryLabel && (
        <ActionLink href={secondaryHref} variant="secondary" size="lg" theme="dark">{secondaryLabel}</ActionLink>
      )}
    </div>
  </div>
</section>
