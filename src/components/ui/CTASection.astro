---
import ActionLink from './ActionLink.astro';

interface Props {
  title: string;
  description: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  primaryTestId?: string;
  eyebrow?: string;
  tone?: 'strong' | 'quiet';
  align?: 'left' | 'center';
}

const {
  title, description,
  primaryHref = '/trial',
  primaryLabel = '体験レッスンを申し込む',
  secondaryHref,
  secondaryLabel,
  primaryTestId,
  eyebrow,
  tone = 'strong',
  align = 'center',
} = Astro.props;
const strong = tone === 'strong';
---

<section class={`site-section ${strong ? 'site-section--dark' : 'quiet-rule bg-canvas'}`}>
  <div class={`${align === 'center' ? 'site-container-narrow text-center' : 'site-container'}`}>
    {eyebrow && <p class={`eyebrow ${strong ? '!text-accent' : ''}`}>{eyebrow}</p>}
    <h2 class={`section-title mb-4 ${strong ? 'text-canvas' : 'text-ink'}`}>{title}</h2>
    <p class={`${align === 'center' ? 'mx-auto' : ''} mb-8 max-w-xl text-base leading-8 ${strong ? 'text-canvas/80' : 'text-ink-secondary'}`}>{description}</p>
    <div class={`flex flex-col items-stretch gap-3 sm:flex-row sm:items-center ${align === 'center' ? 'justify-center' : ''}`}>
      <ActionLink href={primaryHref} size="lg" theme={strong ? 'dark' : 'light'} testId={primaryTestId}>{primaryLabel}</ActionLink>
      {secondaryHref && secondaryLabel && (
        <ActionLink href={secondaryHref} variant="secondary" size="lg" theme={strong ? 'dark' : 'light'}>{secondaryLabel}</ActionLink>
      )}
    </div>
  </div>
</section>
