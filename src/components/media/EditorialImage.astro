---
import { Picture } from 'astro:assets';
import type { EditorialImage as EditorialImageData } from '../../types';

interface Props {
  image: EditorialImageData;
  widths?: number[];
  sizes?: string;
  aspect?: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  showCaption?: boolean;
}

const {
  image,
  widths = [480, 720, 960, 1280, 1600],
  sizes = '(min-width: 1024px) 50vw, 100vw',
  aspect = '4 / 3',
  class: className = '',
  loading = 'lazy',
  fetchpriority = 'auto',
  showCaption = true,
} = Astro.props;

const style = `--editorial-position-desktop:${image.focalPoint?.desktop ?? '50% 50%'};--editorial-position-mobile:${image.focalPoint?.mobile ?? '50% 50%'}`;
---

<figure class={`editorial-image ${className}`} style={style}>
  <div class="editorial-image__frame" style={`aspect-ratio:${aspect}`}>
    <Picture
      src={image.src}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={widths}
      sizes={sizes}
      alt={image.alt}
      loading={loading}
      decoding="async"
      fetchpriority={fetchpriority}
    />
  </div>
  {showCaption && image.caption && <figcaption>{image.caption}</figcaption>}
</figure>
