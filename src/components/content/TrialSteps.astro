---
import { trialSteps } from '../../data/site';

interface Props {
  density?: 'summary' | 'detailed';
}

const { density = 'summary' } = Astro.props;
---

<ol class={`trial-steps trial-steps--${density}`}>
  {trialSteps.map((step, index) => (
    <li>
      <span class="trial-steps__number" aria-hidden="true">{index + 1}</span>
      <div>
        <h3>{step.title}</h3>
        <p>{step.body}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .trial-steps { display: grid; margin: 0; padding: 0; list-style: none; }
  .trial-steps li { display: grid; grid-template-columns: 2.5rem 1fr; gap: 1rem; padding: 1.25rem 0; border-top: 1px solid rgb(var(--color-border-default)); }
  .trial-steps li:last-child { border-bottom: 1px solid rgb(var(--color-border-default)); }
  .trial-steps__number { display: flex; width: 2.25rem; height: 2.25rem; align-items: center; justify-content: center; border: 1px solid rgb(var(--color-accent)); border-radius: 50%; color: rgb(var(--color-brand-primary)); font-weight: 700; }
  .trial-steps h3 { margin-bottom: .25rem; font-family: "Noto Serif JP", "Yu Mincho", "Hiragino Mincho ProN", serif; font-size: 1.125rem; }
  .trial-steps p { margin: 0; color: rgb(var(--color-text-secondary)); font-size: .9375rem; line-height: 1.8; }
  @media (min-width: 768px) {
    .trial-steps--summary { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
    .trial-steps--summary li { display: block; border-bottom: 1px solid rgb(var(--color-border-default)); }
    .trial-steps--summary .trial-steps__number { margin-bottom: 1rem; }
  }
</style>
