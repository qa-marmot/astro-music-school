---
import { trialSteps } from '../../data/site';

interface Props {
  density?: 'summary' | 'detailed';
}

const { density = 'summary' } = Astro.props;
---

<ol class={`trial-steps trial-steps--${density}`}>
  {trialSteps.map((step, index) => (
    <li>
      <span class="trial-steps__number" aria-hidden="true">{index + 1}</span>
      <div>
        <h3>{step.title}</h3>
        <p>{step.body}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .trial-steps { display: grid; margin: 0; padding: 0; list-style: none; }
  .trial-steps li { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: var(--space-md); padding-block: var(--space-lg); border-top: var(--rule-hair) solid var(--color-rule); }
  .trial-steps li:last-child { border-bottom: var(--rule-hair) solid var(--color-rule-2); }
  .trial-steps__number { display: grid; width: 2.5rem; height: 2.5rem; place-items: center; border-radius: var(--radius-md); color: var(--color-accent-ink); background: var(--color-paper-3); font-family: var(--font-display); font-size: 1.125rem; font-variant-numeric: tabular-nums; font-weight: 700; line-height: 1; }
  .trial-steps h3 { margin-bottom: var(--space-2xs); font-family: var(--font-display); font-size: 1.125rem; }
  .trial-steps p { margin: 0; color: var(--color-ink-2); font-size: .9375rem; line-height: 1.8; }
  @media (min-width: 48rem) {
    .trial-steps--summary { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-xl); border-block: var(--rule-hair) solid var(--color-rule-2); }
    .trial-steps--summary li { display: block; border: 0; }
    .trial-steps--summary .trial-steps__number { display: block; margin-bottom: var(--space-md); }
  }
</style>
