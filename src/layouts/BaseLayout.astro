---
import SEOHead from '../components/common/SEOHead.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import { safeJsonLd } from '../lib/sanitize';
import { assertProductionContent, isDemo } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
  preloadImage?: string;
}

assertProductionContent();
const { jsonLd, ...seoProps } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <SEOHead {...seoProps} />
    {jsonLd && !isDemo && <script type="application/ld+json" set:html={safeJsonLd(jsonLd)} />}
  </head>
  <body>
    <a href="#main-content" class="skip-link">本文へ移動</a>
    <Header />
    <main id="main-content" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
